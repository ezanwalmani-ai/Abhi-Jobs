             data.userId is string && data.userId == userId &&
             isValidId(data.courseId) &&
             data.courseSlug is string && data.courseSlug.size() > 0 && data.courseSlug.size() <= 128 &&
             data.courseTitle is string && data.courseTitle.size() > 0 && data.courseTitle.size() <= 160 &&
             data.assessmentType is string && (data.assessmentType == 'module_quiz' || data.assessmentType == 'final_assessment') &&
             (!('moduleId' in data) || (data.moduleId is string && data.moduleId.size() <= 128)) &&
             data.assessmentTitle is string && data.assessmentTitle.size() > 0 && data.assessmentTitle.size() <= 180 &&
             data.attemptNumber is number && data.attemptNumber >= 1 && data.attemptNumber <= 500 &&
             data.totalQuestions is number && data.totalQuestions >= 1 && data.totalQuestions <= 30 &&
             data.correctAnswers is number && data.correctAnswers >= 0 && data.correctAnswers <= data.totalQuestions &&
             data.incorrectAnswers is number && data.incorrectAnswers >= 0 && data.incorrectAnswers <= data.totalQuestions &&
             (data.correctAnswers + data.incorrectAnswers == data.totalQuestions) &&
             data.scorePercent is number && data.scorePercent >= 0 && data.scorePercent <= 100 &&
             data.passPercentage is number && data.passPercentage >= 1 && data.passPercentage <= 100 &&
             data.passed is bool &&
             data.passed == (data.scorePercent >= data.passPercentage) &&
             data.answers is map && data.answers.size() <= 30 &&
             data.questionResults is list && data.questionResults.size() <= 30 &&
             (data.questionResults.size() == 0 || data.questionResults[0] is map) &&
             isValidHexSignature(data.verificationSignature);
    }

    // Preserves 100% of existing server_hmac certificate validation AND cleanly supports
    // interim Starter-tier Admin-Approved certificates without fabricating fake HMAC signatures.
    function isValidCandidateCertificate(data, userId, courseId) {
      return data.keys().hasAll([
               'certificateId',
               'userId',
               'candidateName',
               'courseId',
               'courseSlug',
               'courseTitle',
               'completionDate',
               'templateId',
               'status',
               'issuedAt'
             ]) &&
             data.keys().hasOnly([
               'certificateId',
               'userId',
               'candidateName',
               'courseId',
               'courseSlug',
               'courseTitle',
               'completionDate',
               'finalAssessmentScore',
               'finalAttemptId',
               'templateId',
               'status',
               'issuanceMethod',
               'approvedBy',
               'approvalNote',
               'verificationSignature',
               'issuedAt'
             ]) &&
             isValidCertificateId(data.certificateId) &&
             data.userId is string && data.userId == userId &&
             data.candidateName is string && data.candidateName.size() > 0 && data.candidateName.size() <= 120 &&
             data.courseId == courseId && isValidId(data.courseId) &&
             data.courseSlug is string && data.courseSlug.size() > 0 && data.courseSlug.size() <= 128 &&
             data.courseTitle is string && data.courseTitle.size() > 0 && data.courseTitle.size() <= 160 &&
             data.completionDate is string && data.completionDate.size() > 0 && data.completionDate.size() <= 64 &&
             isValidId(data.templateId) &&
             data.status is string && (data.status == 'valid' || data.status == 'revoked') &&
             (!('approvalNote' in data) || (data.approvalNote is string && data.approvalNote.size() <= 500)) &&
             (
               // Branch A: Preserved server_hmac certificate contract
               ((!('issuanceMethod' in data) || data.issuanceMethod == 'server_hmac') &&
                'finalAssessmentScore' in data && data.finalAssessmentScore is number && data.finalAssessmentScore >= 70 && data.finalAssessmentScore <= 100 &&
                'finalAttemptId' in data && isValidId(data.finalAttemptId) &&
                'verificationSignature' in data && isValidHexSignature(data.verificationSignature)) ||
               // Branch B: Interim Starter-tier Admin-Approved certificate contract
               ('issuanceMethod' in data && data.issuanceMethod == 'admin_approved' &&
                'approvedBy' in data && data.approvedBy is string && data.approvedBy.size() > 0 && data.approvedBy.size() <= 128 &&
                !('verificationSignature' in data) &&
                (!('finalAssessmentScore' in data) || (data.finalAssessmentScore is number && data.finalAssessmentScore >= 0 && data.finalAssessmentScore <= 100)) &&
                (!('finalAttemptId' in data) || isValidId(data.finalAttemptId)))
             );
    }

