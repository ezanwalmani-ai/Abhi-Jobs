             isValidId(data.id) &&
             isValidId(data.userId) &&
             data.candidateName is string && data.candidateName.size() > 0 && data.candidateName.size() <= 120 &&
             isValidId(data.courseId) &&
             data.courseSlug is string && data.courseSlug.size() > 0 && data.courseSlug.size() <= 128 &&
             data.courseTitle is string && data.courseTitle.size() > 0 && data.courseTitle.size() <= 160 &&
             data.completedLessonsCount is number && data.completedLessonsCount >= 0 && data.completedLessonsCount <= 500 &&
             (!('candidateNote' in data) || (data.candidateNote is string && data.candidateNote.size() <= 1000)) &&
             data.status is string && (data.status in ['pending', 'approved', 'rejected']) &&
             (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128)) &&
             (!('reviewNote' in data) || (data.reviewNote is string && data.reviewNote.size() <= 1000)) &&
             (!('issuedCertificateId' in data) || isValidCertificateId(data.issuedCertificateId));
    }

    // =========================================================================
    // LEGACY ADMINS REGISTRY & 5-ROLE RBAC COLLECTION
    // =========================================================================

    // Preserved legacy registry (Console/Server-managed only; zero client access)
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // Authoritative 5-role RBAC collection (super_admin, recruitment_admin, course_admin,
    // content_admin, support_admin). Zero client self-escalation or self-registration.
    match /admin_roles/{uid} {
      allow get: if isValidId(uid) && ((isVerifiedUser() && isOwner(uid)) || isSuperAdmin());
      allow list: if isSuperAdmin();

      allow create: if isVerifiedUser() &&
                       isValidId(uid) &&
                       isValidAdminRole(incoming(), uid) &&
                       incoming().assignedBy == request.auth.uid &&
                       incoming().assignedAt == request.time &&
                       incoming().updatedAt == request.time &&
                       isSuperAdmin();

      allow update: if isVerifiedUser() &&
                       isValidId(uid) &&
                       isValidAdminRole(incoming(), uid) &&
                       incoming().uid == existing().uid &&
                       incoming().assignedAt == existing().assignedAt &&
                       incoming().assignedBy == request.auth.uid &&
                       incoming().updatedAt == request.time &&
                       // Prevent Super Admin from accidentally locking themselves out
                       !(uid == request.auth.uid && (incoming().status == 'revoked' || incoming().role != 'super_admin')) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'email',
                         'displayName',
                         'role',
                         'status',
                         'assignedBy',
                         'notes',
                         'updatedAt'
                       ]) &&
                       isSuperAdmin();

      // Use status == 'revoked' rather than hard delete to retain role history
      allow delete: if false;
    }

    // =========================================================================
    // TRUSTED ADMIN ACTIVITY LOGS (DEFERRED UNTIL SERVER BACKEND / CLOUD FUNCTIONS)
    // =========================================================================
    // Browser clients MUST NOT write to admin_activity_logs; client-written logs
    // cannot be trusted as tamper-proof audit trails.

    match /admin_activity_logs/{logId} {
      allow get: if isSuperAdmin() && isValidId(logId);
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // =========================================================================
    // PLATFORM METRICS SNAPSHOTS (Admin-Only Read; Super Admin Snapshot Write)
    // =========================================================================

    match /platform_metrics/{metricId} {
      allow get: if isAnyAdmin() && isValidId(metricId);
      allow list: if isAnyAdmin();

      allow create: if isVerifiedUser() &&
                       isValidId(metricId) &&
                       isValidPlatformMetrics(incoming(), metricId) &&
                       incoming().updatedAt == request.time &&
                       isSuperAdmin();

      allow update: if isVerifiedUser() &&
                       isValidId(metricId) &&
                       isValidPlatformMetrics(incoming(), metricId) &&
                       incoming().id == existing().id &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'periodType',
                         'totalCandidates',
                         'totalEmployers',
                         'verifiedEmployers',
                         'publishedJobs',
                         'totalApplications',
                         'totalEnrolments',
                         'totalCertificates',
                         'openHiringEnquiries',
                         'openCourseEnquiries',
                         'generatedBy',
                         'updatedAt'
                       ]) &&
                       isSuperAdmin();

      allow delete: if false;
    }

    // =========================================================================
    // USERS COLLECTION & PRIVATE SUBCOLLECTIONS (Pillar 6: PII Isolation)
    // =========================================================================

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isRecruitmentAdmin() || isSupportAdmin());
      allow list: if (isSignedIn() && resource.data.id == request.auth.uid) || isRecruitmentAdmin() || isSupportAdmin();

      // Users may only create their own profile as 'job_seeker' or 'employer' (NEVER 'admin').
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().id == request.auth.uid &&
                       isValidUser(incoming()) &&
                       (incoming().role == 'job_seeker' || incoming().role == 'employer') &&
                       (!('status' in incoming()) || incoming().status == 'active');

      // Users cannot alter their role, change an assigned candidateCode, or self-reactivate a suspended account.
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().role == existing().role &&
                       (!('candidateCode' in existing()) || incoming().candidateCode == existing().candidateCode) &&
                       (
                         (isOwner(userId) &&
                          (!('status' in existing()) || existing().status == 'active') &&
                          (!('status' in incoming()) || incoming().status == existing().status) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'lastActive', 'candidateCode']) &&
                          (!('candidateCode' in incoming().diff(existing()).affectedKeys()) || !('candidateCode' in existing()))) ||
                         ((isSuperAdmin() || isSupportAdmin()) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastActive', 'candidateCode']) &&
                          (!('candidateCode' in incoming().diff(existing()).affectedKeys()) || !('candidateCode' in existing()))) ||
                         (isRecruitmentAdmin() &&
                          !('candidateCode' in existing()) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['candidateCode']))
                       );

      allow delete: if false;

      // PRESERVED: Private per-candidate Career Profile Evaluation Assessments (Owner + Authorized Admins)
      match /career_assessments/{assessmentId} {
        allow get: if isValidId(userId) && isValidId(assessmentId) && (isOwner(userId) || isRecruitmentAdmin() || isSupportAdmin());
        allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isRecruitmentAdmin() || isSupportAdmin();

        allow create: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(assessmentId) &&
                         isValidAssessment(incoming(), userId, assessmentId) &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time;

        allow update: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(assessmentId) &&
                         isValidAssessment(incoming(), userId, assessmentId) &&
                         existing().status == 'in_progress' &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt == request.time &&
                         (
                           (incoming().status == 'in_progress' &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'currentStep',
                               'basicInfo',
                               'education',
                               'experience',
                               'careerPreferences',
                               'skillsEvaluation',
                               'practicalAnswers',
                               'learningRecommendationConsent',
                               'recruitmentConsent',
                               'updatedAt'
                             ])) ||
                           (incoming().status == 'submitted' &&
                             incoming().learningRecommendationConsent == true &&
                             'report' in incoming() &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'status',
                               'currentStep',
                               'basicInfo',
                               'education',
                               'experience',
                               'careerPreferences',
                               'skillsEvaluation',
                               'practicalAnswers',
                               'learningRecommendationConsent',
                               'recruitmentConsent',
                               'report',
                               'submittedAt',
                               'updatedAt'
                             ]))
                         );

        allow delete: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(assessmentId) &&
                         existing().status == 'in_progress';
      }

      // PRESERVED (ZERO STUDENT SCORE/UNLOCK/COMPLETION WRITES):
      // Students may create a clean initial enrolment and update ONLY non-authoritative
      // lesson resume/completion bookmarks. Quiz passes, module unlocks, final assessment
      // scores, and 'completed' status CANNOT be written by students — only Course/Super Admins.
      match /course_enrolments/{courseId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(courseId);
        allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAdmin();

        allow create: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(courseId) &&
                         isValidCourseEnrolment(incoming(), userId, courseId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().status == 'enrolled' &&
                         incoming().completedLessonIds.size() == 0 &&
                         (!('completedModuleIds' in incoming()) || incoming().completedModuleIds.size() == 0) &&
                         incoming().passedModuleQuizIds.size() == 0 &&
                         incoming().unlockedModuleOrder == 1 &&
                         incoming().finalAssessmentPassed == false &&
                         incoming().progressPercent == 0 &&
                         !('completedAt' in incoming()) &&
                         !('bestFinalScorePercent' in incoming()) &&
                         !('lastVerifiedAttemptId' in incoming()) &&
                         !('lastVerifiedFinalAttemptId' in incoming()) &&
                         incoming().enrolledAt == request.time &&
                         incoming().lastAccessedAt == request.time;

        allow update: if isValidId(userId) &&
                         isValidId(courseId) &&
                         isValidCourseEnrolment(incoming(), userId, courseId) &&
                         incoming().courseId == existing().courseId &&
                         incoming().courseSlug == existing().courseSlug &&
                         incoming().courseTitle == existing().courseTitle &&
                         incoming().categoryId == existing().categoryId &&
                         incoming().userId == existing().userId &&
                         incoming().enrolledAt == existing().enrolledAt &&
                         incoming().lastAccessedAt == request.time &&
                         (
                           isAdmin() ||
                           (
                             isVerifiedUser() &&
                             isOwner(userId) &&
                             existing().status != 'completed' &&
                             (incoming().status == 'enrolled' || incoming().status == 'in_progress') &&
                             incoming().passedModuleQuizIds == existing().passedModuleQuizIds &&
                             incoming().unlockedModuleOrder == existing().unlockedModuleOrder &&
                             incoming().finalAssessmentPassed == existing().finalAssessmentPassed &&
                             incoming().progressPercent == existing().progressPercent &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'currentModuleId',
                               'currentLessonId',
                               'completedLessonIds',
                               'status',
                               'lastAccessedAt'
                             ])
                           )
                         );

        allow delete: if isAdmin() && isValidId(userId) && isValidId(courseId);
      }

      // PRESERVED: Private per-candidate YouTube Video Playback Telemetry
      match /video_progress/{progressKey} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(progressKey);
        allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAdmin();

        allow create: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(progressKey) &&
                         isValidVideoProgress(incoming(), userId, progressKey) &&
                         incoming().updatedAt == request.time;

        allow update: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(progressKey) &&
                         isValidVideoProgress(incoming(), userId, progressKey) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().courseId == existing().courseId &&
                         incoming().lessonId == existing().lessonId &&
                         incoming().videoId == existing().videoId &&
                         incoming().youtubeVideoId == existing().youtubeVideoId &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'durationSeconds',
                           'watchedSeconds',
                           'maxPercentWatched',
                           'lastPositionSeconds',
                           'hasPlayed',
                           'completedViaPlayer',
                           'manualCompleted',
                           'updatedAt'
                         ]);

        allow delete: if isAdmin() && isValidId(userId) && isValidId(progressKey);
      }

      // PRESERVED (ZERO STUDENT WRITES): Private per-candidate Quiz & Final Assessment Attempts
      match /assessment_attempts/{attemptId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(attemptId);
        allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAdmin();

        allow create: if isAdmin() &&
                         isValidId(userId) &&
                         isValidId(attemptId) &&
                         isValidAssessmentAttempt(incoming(), userId, attemptId) &&
                         incoming().submittedAt == request.time;

        allow update: if false;
        allow delete: if isAdmin() && isValidId(userId) && isValidId(attemptId);
      }

      // PRESERVED (ZERO STUDENT WRITES): Course Completion Certificates
      // Supports preserved server_hmac certificates AND Starter-tier Admin-Approved certificates
      // (strictly admin-issued with atomic /public_certificates/{certificateId} sync).
      match /certificates/{courseId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(courseId);
        allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAdmin();

        allow create: if isAdmin() &&
                         isValidId(userId) &&
                         isValidId(courseId) &&
                         isValidCandidateCertificate(incoming(), userId, courseId) &&
                         incoming().status == 'valid' &&
                         incoming().issuedAt == request.time &&
                         (!('issuanceMethod' in incoming()) || incoming().issuanceMethod != 'admin_approved' || incoming().approvedBy == request.auth.uid) &&
                         getAfter(/databases/$(database)/documents/public_certificates/$(incoming().certificateId)).data.courseId == courseId &&
                         getAfter(/databases/$(database)/documents/public_certificates/$(incoming().certificateId)).data.status == 'valid';

        allow update: if isAdmin() &&
                         isValidId(userId) &&
                         isValidId(courseId) &&
                         isValidCandidateCertificate(incoming(), userId, courseId) &&
                         incoming().certificateId == existing().certificateId &&
                         incoming().userId == existing().userId &&
                         incoming().courseId == existing().courseId &&
                         incoming().issuedAt == existing().issuedAt &&
                         (!('finalAttemptId' in existing()) || incoming().finalAttemptId == existing().finalAttemptId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status']);

        allow delete: if isAdmin() && isValidId(userId) && isValidId(courseId);
      }

      // PHASE 2B: Private Structured JSON Resumes (Owner + Authorized Recruitment/Support Admins)
      match /resumes/{resumeId} {
        allow get: if isValidId(userId) && isValidId(resumeId) && (isOwner(userId) || isRecruitmentAdmin() || isSupportAdmin());
        allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isRecruitmentAdmin() || isSupportAdmin();

        allow create: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(resumeId) &&
                         isValidCandidateResume(incoming(), userId, resumeId) &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time;

        allow update: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(resumeId) &&
                         isValidCandidateResume(incoming(), userId, resumeId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title',
                           'targetRole',
                           'fullName',
                           'professionalTitle',
                           'email',
                           'phone',
                           'city',
                           'state',
                           'linkedIn',
                           'portfolio',
                           'summary',
                           'template',
                           'design',
                           'skillCategories',
                           'skills',
                           'experiences',
                           'education',
                           'projects',
                           'certifications',
                           'languages',
                           'achievements',
                           'awards',
                           'training',
                           'volunteer',
                           'publications',
                           'memberships',
                           'customSections',
                           'updatedAt'
                         ]);

        allow delete: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(resumeId);
      }

      // PHASE 2B: Private Saved Jobs (Strictly Owner-Only)
      match /saved_jobs/{jobId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(jobId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(jobId) &&
                         isValidSavedJob(incoming(), userId, jobId) &&
                         incoming().savedAt == request.time &&
                         exists(/databases/$(database)/documents/jobs/$(jobId));

        allow update: if false;

        allow delete: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(jobId);
      }

      // PHASE 2B: Private Recently Viewed Jobs (Strictly Owner-Only)
      match /recently_viewed/{jobId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(jobId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(jobId) &&
                         isValidRecentlyViewedJob(incoming(), userId, jobId) &&
                         incoming().viewedAt == request.time;

        allow update: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(jobId) &&
                         isValidRecentlyViewedJob(incoming(), userId, jobId) &&
                         incoming().jobId == existing().jobId &&
                         incoming().userId == existing().userId &&
                         incoming().viewedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['viewedAt']);

        allow delete: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(jobId);
      }

      // PHASE 2B: Private Per-User Notifications (Owner Read/Mark-Read; Admins Create)
      match /notifications/{notificationId} {
        allow get: if isValidId(userId) && isValidId(notificationId) && (isOwner(userId) || isAnyAdmin());
        allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAnyAdmin();

        allow create: if (isSuperAdmin() || isRecruitmentAdmin() || isCourseAdmin() || isSupportAdmin()) &&
                         isValidId(userId) &&
                         isValidId(notificationId) &&
                         isValidUserNotification(incoming(), userId, notificationId) &&
                         incoming().createdBy == request.auth.uid &&
                         incoming().read == false &&
                         incoming().createdAt == request.time;

        allow update: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(notificationId) &&
                         isValidUserNotification(incoming(), userId, notificationId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdBy == existing().createdBy &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['read']);

        allow delete: if isValidId(userId) && isValidId(notificationId) && (isOwner(userId) || isSuperAdmin());
      }

      // Private Job Search Email Alerts (Strictly Owner-Only)
      match /job_alerts/{alertId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(alertId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(alertId) &&
                         isValidJobSearchAlert(incoming(), userId, alertId) &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time;

        allow update: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(alertId) &&
                         isValidJobSearchAlert(incoming(), userId, alertId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().queryKey == existing().queryKey &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'email',
                           'label',
                           'frequency',
                           'enabled',
                           'updatedAt'
                         ]);

        allow delete: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(alertId);
      }
    }

    // =========================================================================
    // CANDIDATE PROFILES (STRICT PII ISOLATION) & OPT-IN DIRECTORY (SPLIT COLLECTION)
    // =========================================================================

    match /candidates/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isRecruitmentAdmin() || isSupportAdmin());
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isRecruitmentAdmin() || isSupportAdmin();

      allow create: if isVerifiedUser() &&
                       isOwner(uid) &&
                       isValidId(uid) &&
                       isValidCandidateProfile(incoming(), uid) &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
                       isValidId(uid) &&
                       isValidCandidateProfile(incoming(), uid) &&
                       incoming().id == existing().id &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       (!('candidateCode' in existing()) || incoming().candidateCode == existing().candidateCode) &&
                       (
                         (isOwner(uid) &&
                          (!('recruitmentStatus' in existing())
                            ? !('recruitmentStatus' in incoming())
                            : incoming().recruitmentStatus == existing().recruitmentStatus) &&
                          (!('candidateCode' in incoming().diff(existing()).affectedKeys()) || !('candidateCode' in existing())) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'candidateCode',
                            'name',
                            'email',
                            'phone',
                            'altPhone',
                            'location',
                            'city',
                            'state',
                            'country',
                            'pinCode',
                            'headline',
                            'about',
                            'careerObjective',
                            'currentRole',
                            'currentCompany',
                            'desiredRole',
                            'noticePeriod',
                            'experienceLevel',
                            'experienceType',
                            'workStatus',
                            'yearsOfExperience',
                            'preferredLocation',
                            'preferredLocations',
                            'preferredJobTitles',
                            'preferredEmploymentTypes',
                            'preferredShift',
                            'jobSearchStatus',
                            'workPreference',
                            'preferredIndustry',
                            'currentSalary',
                            'expectedSalary',
                            'willingToRelocate',
                            'gender',
                            'dob',
                            'marketingConsent',
                            'availability',
                            'profileVisibility',
                            'availableForOpportunities',
                            'skills',
                            'detailedSkills',
                            'education',
                            'experiences',
                            'certifications',
                            'projects',
                            'languages',
                            'linkedinUrl',
                            'githubUrl',
                            'portfolioUrl',
                            'personalWebsiteUrl',
                            'otherLinks',
                            'primaryResumeId',
                            'resumeDocId',
                            'resumeName',
                            'resumeSize',
                            'resumeUpdated',
                            'completionPercentage',
                            'avatar',
                            'updatedAt'
                          ])) ||
                         // Authorized Recruitment/Super Admins may ONLY update permitted recruitment status or backfill missing candidateCode (never silently edit candidate-submitted profile fields)
                         (isRecruitmentAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['recruitmentStatus', 'candidateCode', 'updatedAt']) &&
                          (!('candidateCode' in incoming().diff(existing()).affectedKeys()) || !('candidateCode' in existing())))
                       );

      allow delete: if false;

      // Private uploaded resume & document metadata/version history (Owner + Authorized Admins; never deleted)
      match /documents/{docId} {
        allow get, list: if isValidId(uid) && (isOwner(uid) || isRecruitmentAdmin() || isSupportAdmin());
        allow create: if isVerifiedUser() &&
                         isOwner(uid) &&
                         isValidId(uid) &&
                         isValidId(docId) &&
                         isValidCandidateDocument(incoming(), uid, docId) &&
                         incoming().uploadedAt == request.time;
        allow update, delete: if false;
      }

      // Isolated private internal recruitment notes per candidate (Strictly DENIED to candidates)
      match /internal_notes/{noteId} {
        allow get, list: if isValidId(uid) && (isRecruitmentAdmin() || isSupportAdmin());
        allow create: if isVerifiedUser() &&
                         isRecruitmentAdmin() &&
                         isValidId(uid) &&
                         isValidId(noteId) &&
                         isValidCandidateInternalNote(incoming(), uid, noteId) &&
                         incoming().createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Standard 4-Digit Candidate ID Uniqueness Registry (1000-9999) — Immutable & Never Reused
    match /candidate_id_registry/{candidateCode} {
      allow get: if isSignedIn() && isValidCandidateCode(candidateCode);
      allow list: if isRecruitmentAdmin() || isSupportAdmin();
      allow create: if isSignedIn() &&
                       isValidCandidateCode(candidateCode) &&
                       !exists(/databases/$(database)/documents/candidate_id_registry/$(candidateCode)) &&
                       isValidCandidateIdRegistry(incoming(), candidateCode) &&
                       incoming().assignedAt == request.time &&
                       (incoming().userId == request.auth.uid || isRecruitmentAdmin());
      allow update, delete: if false;
    }

    // Non-PII opt-in discovery card readable strictly by Verified Employers & Recruitment/Support/Super Admins.
    // Never stores email, phone, DOB, expected salary, or resume files.
    match /candidate_directory/{uid} {
      allow get: if isValidId(uid) && (
        isOwner(uid) ||
        (resource.data.availableForOpportunities == true && isVerifiedEmployer()) ||
        isRecruitmentAdmin() ||
        isSupportAdmin()
      );
      allow list: if (isSignedIn() && resource.data.uid == request.auth.uid) ||
                     (resource.data.availableForOpportunities == true && isVerifiedEmployer()) ||
                     isRecruitmentAdmin() ||
                     isSupportAdmin();

      allow create: if isVerifiedUser() &&
                       isOwner(uid) &&
                       isValidId(uid) &&
                       isValidCandidateDirectoryEntry(incoming(), uid) &&
                       incoming().updatedAt == request.time &&
                       exists(/databases/$(database)/documents/candidates/$(uid));

      allow update: if isVerifiedUser() &&
                       isOwner(uid) &&
                       isValidId(uid) &&
                       isValidCandidateDirectoryEntry(incoming(), uid) &&
                       incoming().uid == existing().uid &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName',
                         'headline',
                         'location',
                         'desiredRole',
                         'experienceLevel',
                         'yearsOfExperience',
                         'workPreference',
                         'availability',
                         'skills',
                         'availableForOpportunities',
                         'completionPercentage',
                         'updatedAt'
                       ]);

      allow delete: if isValidId(uid) && ((isVerifiedUser() && isOwner(uid)) || isSuperAdmin());
    }

    // =========================================================================
    // EMPLOYERS & PRIVATE RECRUITER CONTACTS (VERIFICATION LOCK + PII SPLIT)
    // =========================================================================

    match /employers/{employerId} {
      // Only verified companies are publicly visible; owners and recruitment/support admins can view all states.
      allow get: if isValidId(employerId) && (
        resource.data.verificationStatus == 'verified' ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid) ||
        isRecruitmentAdmin() ||
        isSupportAdmin()
      );
      allow list: if resource.data.verificationStatus == 'verified' ||
                     (isSignedIn() && resource.data.ownerUid == request.auth.uid) ||
                     isRecruitmentAdmin() ||
                     isSupportAdmin();

      allow create: if isValidId(employerId) &&
                       isValidEmployerProfile(incoming(), employerId) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time &&
                       (
                         // Self-registered employer: strictly forced to pending & unverified
                         (isVerifiedUser() &&
                          employerId == request.auth.uid &&
                          incoming().ownerUid == request.auth.uid &&
                          incoming().verificationStatus == 'pending' &&
                          incoming().verified == false &&
                          !('verifiedBy' in incoming()) &&
                          !('verifiedAt' in incoming()) &&
                          incoming().activeJobsCount == 0) ||
                         // Admin-created partner employer
                         isRecruitmentAdmin()
                       );

      allow update: if isValidId(employerId) &&
                       isValidEmployerProfile(incoming(), employerId) &&
                       incoming().id == existing().id &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       (
                         // Tier 1: Recruitment / Super Admin verification & moderation
                         isRecruitmentAdmin() ||
                         // Tier 2: Employer owner profile updates ONLY (ZERO self-verification or counter edits)
                         (isVerifiedUser() &&
                          existing().ownerUid == request.auth.uid &&
                          existing().verificationStatus != 'suspended' &&
                          incoming().verificationStatus == existing().verificationStatus &&
                          incoming().verified == existing().verified &&
                          incoming().activeJobsCount == existing().activeJobsCount &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'companyName',
                            'website',
                            'industry',
                            'companySize',
                            'location',
                            'logo',
                            'about',
                            'culture',
                            'benefits',
                            'socialLinks',
                            'updatedAt'
                          ]))
                       );

      allow delete: if isSuperAdmin() && isValidId(employerId);

      // Isolated private recruiter contact PII (Master Gate via parent /employers/{employerId})
      match /private_contacts/{contactId} {
        allow get: if isValidId(employerId) && isValidId(contactId) && (
          isParentEmployerOwner(employerId) ||
          isRecruitmentAdmin() ||
          isSupportAdmin()
        );
        allow list: if isValidId(employerId) && (
          isParentEmployerOwner(employerId) ||
          isRecruitmentAdmin() ||
          isSupportAdmin()
        );

        allow create: if isVerifiedUser() &&
                         isValidId(employerId) &&
                         isValidId(contactId) &&
                         isValidEmployerPrivateContact(incoming(), employerId, contactId) &&
                         incoming().updatedAt == request.time &&
                         exists(/databases/$(database)/documents/employers/$(employerId)) &&
                         (
                           (isParentEmployerOwner(employerId) && incoming().ownerUid == request.auth.uid) ||
                           isRecruitmentAdmin()
                         );

        allow update: if isValidId(employerId) &&
                         isValidId(contactId) &&
                         isValidEmployerPrivateContact(incoming(), employerId, contactId) &&
                         incoming().id == existing().id &&
                         incoming().employerId == existing().employerId &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().updatedAt == request.time &&
                         (
                           (isParentEmployerOwner(employerId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'recruiterName',
                              'recruiterRole',
                              'recruiterEmail',
                              'recruiterPhone',
                              'updatedAt'
                            ])) ||
                           isRecruitmentAdmin()
                         );

        allow delete: if isSuperAdmin() && isValidId(employerId) && isValidId(contactId);
      }
    }

    // =========================================================================
    // JOBS (PUBLIC PUBLISHED READ; VERIFIED EMPLOYER / ADMIN WRITE; ZERO CANDIDATE WRITES)
    // =========================================================================

    match /jobs/{jobId} {
      allow get: if isValidId(jobId) && (
        resource.data.status == 'published' ||
        (isSignedIn() && resource.data.employerOwnerUid == request.auth.uid) ||
        isRecruitmentAdmin() ||
        isSupportAdmin()
      );
      allow list: if resource.data.status == 'published' ||
                     (isSignedIn() && resource.data.employerOwnerUid == request.auth.uid) ||
                     isRecruitmentAdmin() ||
                     isSupportAdmin();

      allow create: if isVerifiedUser() &&
                       isValidId(jobId) &&
                       canCreateJobActor(request.resource.data) &&
                       request.resource.data.applicantsCount == 0 &&
                       request.resource.data.viewsCount == 0 &&
                       request.resource.data.postedAt == request.time &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       exists(/databases/$(database)/documents/employers/$(request.resource.data.employerId)) &&
                       isValidJobPosting(request.resource.data, jobId);

      allow update: if isVerifiedUser() &&
                       isValidId(jobId) &&
                       canUpdateJobActor(request.resource.data, resource.data) &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.employerId == resource.data.employerId &&
                       request.resource.data.employerOwnerUid == resource.data.employerOwnerUid &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       isValidJobPosting(request.resource.data, jobId);

      allow delete: if isRecruitmentAdmin() && isValidId(jobId);
    }

    // =========================================================================
    // APPLICATIONS & ISOLATED RECRUITER INTERNAL NOTES
    // =========================================================================

    match /applications/{applicationId} {
      allow get: if isValidId(applicationId) && (
        (isSignedIn() && (resource.data.candidateId == request.auth.uid || resource.data.employerOwnerUid == request.auth.uid)) ||
        isRecruitmentAdmin() ||
        isSupportAdmin()
      );
      allow list: if (isSignedIn() && (resource.data.candidateId == request.auth.uid || resource.data.employerOwnerUid == request.auth.uid)) ||
                     isRecruitmentAdmin() ||
                     isSupportAdmin();

      allow create: if isVerifiedUser() &&
                       isValidId(applicationId) &&
                       isValidJobApplication(incoming(), applicationId) &&
                       incoming().candidateId == request.auth.uid &&
                       incoming().status == 'Applied' &&
                       !('interviewId' in incoming()) &&
                       !('matchScore' in incoming()) &&
                       incoming().appliedAt == request.time &&
                       incoming().updatedAt == request.time &&
                       // Relational sync: verify target job exists, is published, and matches employer ownership (single get)
                       exists(/databases/$(database)/documents/jobs/$(incoming().jobId)) &&
                       matchesPublishedJob(
                         get(/databases/$(database)/documents/jobs/$(incoming().jobId)).data,
                         incoming()
                       );

      allow update: if isVerifiedUser() &&
                       isValidId(applicationId) &&
                       isValidJobApplication(incoming(), applicationId) &&
                       incoming().id == existing().id &&
                       incoming().jobId == existing().jobId &&
                       incoming().employerId == existing().employerId &&
                       incoming().employerOwnerUid == existing().employerOwnerUid &&
                       incoming().candidateId == existing().candidateId &&
                       incoming().appliedAt == existing().appliedAt &&
                       incoming().updatedAt == request.time &&
                       (
                         // Tier 1: Recruitment / Super Admin pipeline management
                         (isRecruitmentAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status',
                            'timeline',
                            'interviewId',
                            'matchScore',
                            'updatedAt'
                          ])) ||
                         // Tier 2: Owning Employer pipeline review (cannot alter candidate data or resurrect Withdrawn)
                         (existing().employerOwnerUid == request.auth.uid &&
                          existing().status != 'Withdrawn' &&
                          incoming().status != 'Withdrawn' &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status',
                            'timeline',
                            'interviewId',
                            'matchScore',
                            'updatedAt'
                          ])) ||
                         // Tier 3: Candidate withdrawal action ONLY (terminal states locked)
                         (existing().candidateId == request.auth.uid &&
                          !(existing().status in ['Selected', 'Rejected', 'Not Selected', 'Withdrawn']) &&
                          incoming().status == 'Withdrawn' &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status',
                            'timeline',
                            'updatedAt'
                          ]))
                       );

      allow delete: if isSuperAdmin() && isValidId(applicationId);

      // Private recruiter/admin internal notes (Master Gate via parent /applications/{applicationId})
      // Strictly DENIED to candidates.
      match /internal_notes/{noteId} {
        allow get: if isValidId(applicationId) && isValidId(noteId) && (
          isParentApplicationEmployer(applicationId) ||
          isRecruitmentAdmin() ||
          isSupportAdmin()
        );
        allow list: if isValidId(applicationId) && (
          isParentApplicationEmployer(applicationId) ||
          isRecruitmentAdmin() ||
          isSupportAdmin()
        );

        allow create: if isValidId(applicationId) &&
                         isValidId(noteId) &&
                         isValidApplicationInternalNote(incoming(), applicationId, noteId) &&
                         incoming().authorUid == request.auth.uid &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time &&
                         (
                           (isParentApplicationEmployer(applicationId) && incoming().authorRole == 'employer') ||
                           (isRecruitmentAdmin() && (incoming().authorRole == 'recruitment_admin' || incoming().authorRole == 'super_admin'))
                         );

        allow update: if isValidId(applicationId) &&
                         isValidId(noteId) &&
                         isValidApplicationInternalNote(incoming(), applicationId, noteId) &&
                         incoming().id == existing().id &&
                         incoming().applicationId == existing().applicationId &&
                         incoming().authorUid == existing().authorUid &&
                         incoming().authorRole == existing().authorRole &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt']) &&
                         (
                           (isParentApplicationEmployer(applicationId) && existing().authorUid == request.auth.uid) ||
                           isRecruitmentAdmin()
                         );

        allow delete: if isValidId(applicationId) && isValidId(noteId) && (
          (isParentApplicationEmployer(applicationId) && existing().authorUid == request.auth.uid) ||
          isRecruitmentAdmin()
        );
      }
    }

    // =========================================================================
    // INTERVIEWS (CANDIDATE READ-ONLY; OWNING EMPLOYER & RECRUITMENT ADMIN MANAGE)
    // =========================================================================

    match /interviews/{interviewId} {
      allow get: if isValidId(interviewId) && (
        (isSignedIn() && (resource.data.candidateId == request.auth.uid || resource.data.employerOwnerUid == request.auth.uid)) ||
        isRecruitmentAdmin() ||
        isSupportAdmin()
      );
      allow list: if (isSignedIn() && (resource.data.candidateId == request.auth.uid || resource.data.employerOwnerUid == request.auth.uid)) ||
                     isRecruitmentAdmin() ||
                     isSupportAdmin();

      allow create: if isVerifiedUser() &&
                       isValidId(interviewId) &&
                       isValidInterviewSchedule(incoming(), interviewId) &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().status == 'Scheduled' &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time &&
                       exists(/databases/$(database)/documents/applications/$(incoming().applicationId)) &&
                       matchesActiveApplication(
                         get(/databases/$(database)/documents/applications/$(incoming().applicationId)).data,
                         incoming()
                       ) &&
                       (
                         incoming().employerOwnerUid == request.auth.uid ||
                         isRecruitmentAdmin()
                       );

      allow update: if isVerifiedUser() &&
                       isValidId(interviewId) &&
                       isValidInterviewSchedule(incoming(), interviewId) &&
                       incoming().id == existing().id &&
                       incoming().applicationId == existing().applicationId &&
                       incoming().jobId == existing().jobId &&
                       incoming().candidateId == existing().candidateId &&
                       incoming().employerId == existing().employerId &&
                       incoming().employerOwnerUid == existing().employerOwnerUid &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       (
                         isRecruitmentAdmin() ||
                         (existing().employerOwnerUid == request.auth.uid &&
                          !(existing().status in ['Completed', 'Cancelled']) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'scheduledDate',
                            'scheduledTime',
                            'type',
                            'meetingLink',
                            'location',
                            'notes',
                            'status',
                            'updatedAt'
                          ]))
                       );

      allow delete: if isSuperAdmin() && isValidId(interviewId);
    }

    // =========================================================================
    // WEBSITE CMS & PUBLIC SETTINGS (CONTENT ADMIN & SUPER ADMIN WRITABLE)
    // =========================================================================

    match /website_content/{contentKey} {
      allow get: if isValidId(contentKey) && (resource.data.status == 'published' || isAnyAdmin());
      allow list: if resource.data.status == 'published' || isAnyAdmin();

      allow create: if isVerifiedUser() &&
                       isValidId(contentKey) &&
                       isValidWebsiteContent(incoming(), contentKey) &&
                       incoming().updatedAt == request.time &&
                       isContentAdmin();

      allow update: if isVerifiedUser() &&
                       isValidId(contentKey) &&
                       isValidWebsiteContent(incoming(), contentKey) &&
                       incoming().key == existing().key &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'section',
                         'title',
                         'subtitle',
                         'body',
                         'ctaLabel',
                         'ctaUrl',
                         'sortOrder',
                         'status',
                         'updatedBy',
                         'updatedAt'
                       ]) &&
                       isContentAdmin();

      allow delete: if isVerifiedUser() && isValidId(contentKey) && isContentAdmin();
    }

    match /public_settings/{settingKey} {
      allow get: if isValidId(settingKey);
      allow list: if true;

      allow create: if isVerifiedUser() &&
                       isValidId(settingKey) &&
                       isValidPublicSetting(incoming(), settingKey) &&
                       incoming().updatedAt == request.time &&
                       isContentAdmin();

      allow update: if isVerifiedUser() &&
                       isValidId(settingKey) &&
                       isValidPublicSetting(incoming(), settingKey) &&
                       incoming().key == existing().key &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'label',
                         'value',
                         'updatedBy',
                         'updatedAt'
                       ]) &&
                       isContentAdmin();

      allow delete: if isVerifiedUser() && isValidId(settingKey) && isSuperAdmin();
    }

    // =========================================================================
    // HIRING & COURSE ENQUIRIES (PUBLIC CREATE-ONLY; ZERO PUBLIC READS)
    // =========================================================================

    match /hiring_enquiries/{enquiryId} {
      allow get: if isValidId(enquiryId) && (isRecruitmentAdmin() || isSupportAdmin());
      allow list: if isRecruitmentAdmin() || isSupportAdmin();

      allow create: if isValidId(enquiryId) &&
                       isValidHiringEnquiry(incoming(), enquiryId) &&
                       incoming().status == 'New' &&
                       !('assignedRecruiter' in incoming()) &&
                       !('internalNotes' in incoming()) &&
                       (!('submittedByUid' in incoming()) || (isSignedIn() && incoming().submittedByUid == request.auth.uid)) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if (isRecruitmentAdmin() || isSupportAdmin()) &&
                       isValidId(enquiryId) &&
                       isValidHiringEnquiry(incoming(), enquiryId) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status',
                         'assignedRecruiter',
                         'internalNotes',
                         'updatedAt'
                       ]);

      allow delete: if isSuperAdmin() && isValidId(enquiryId);
    }

    match /course_enquiries/{enquiryId} {
      allow get: if isValidId(enquiryId) && (isCourseAdmin() || isSupportAdmin());
      allow list: if isCourseAdmin() || isSupportAdmin();

      allow create: if isValidId(enquiryId) &&
                       isValidCourseEnquiry(incoming(), enquiryId) &&
                       incoming().status == 'New' &&
                       !('internalNotes' in incoming()) &&
                       (!('submittedByUid' in incoming()) || (isSignedIn() && incoming().submittedByUid == request.auth.uid)) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if (isCourseAdmin() || isSupportAdmin()) &&
                       isValidId(enquiryId) &&
                       isValidCourseEnquiry(incoming(), enquiryId) &&
                       incoming().id == existing().id &&
                       incoming().courseId == existing().courseId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status',
                         'internalNotes',
                         'updatedAt'
                       ]);

      allow delete: if isSuperAdmin() && isValidId(enquiryId);
    }

    // =========================================================================
    // ADMIN-APPROVED CERTIFICATE ISSUANCE QUEUE (INTERIM STARTER-TIER FLOW)
    // =========================================================================

    match /certificate_requests/{requestId} {
      allow get: if isValidId(requestId) && (
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        isCourseAdmin() ||
        isSupportAdmin()
      );
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) ||
                     isCourseAdmin() ||
                     isSupportAdmin();

      // Verified enrolled students may submit a pending completion review request ONLY.
      allow create: if isVerifiedUser() &&
                       isValidId(requestId) &&
                       isValidCertificateApprovalRequest(incoming(), requestId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'pending' &&
                       !('reviewedBy' in incoming()) &&
                       !('reviewNote' in incoming()) &&
                       !('issuedCertificateId' in incoming()) &&
                       incoming().requestedAt == request.time &&
                       incoming().updatedAt == request.time &&
                       exists(/databases/$(database)/documents/users/$(request.auth.uid)/course_enrolments/$(incoming().courseId));

      // Only Course Admin / Super Admin may approve or reject requests.
      allow update: if isCourseAdmin() &&
                       isValidId(requestId) &&
                       isValidCertificateApprovalRequest(incoming(), requestId) &&
                       incoming().id == existing().id &&
                       incoming().userId == existing().userId &&
                       incoming().courseId == existing().courseId &&
                       incoming().requestedAt == existing().requestedAt &&
                       incoming().reviewedBy == request.auth.uid &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status',
                         'reviewedBy',
                         'reviewNote',
                         'issuedCertificateId',
                         'updatedAt'
                       ]);

      allow delete: if isSuperAdmin() && isValidId(requestId);
    }

    // =========================================================================
    // PRESERVED: PUBLIC CERTIFICATE VERIFICATION REGISTRY
    // =========================================================================

    match /public_certificates/{certificateId} {
      allow get: if isValidCertificateId(certificateId);
      allow list: if isAdmin();

      allow create: if isAdmin() &&
                       isValidCertificateId(certificateId) &&
                       isValidPublicCertificate(incoming(), certificateId) &&
                       incoming().status == 'valid' &&
                       incoming().issuedAt == request.time;

      allow update: if isAdmin() &&
                       isValidCertificateId(certificateId) &&
                       isValidPublicCertificate(incoming(), certificateId) &&
                       incoming().certificateId == existing().certificateId &&
                       incoming().courseId == existing().courseId &&
                       incoming().issuedAt == existing().issuedAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status']);

      allow delete: if isAdmin() && isValidCertificateId(certificateId);
    }

    // =========================================================================
    // PRESERVED: ADMIN-MANAGED LEARN WITH ABHI COURSES, MODULES, LESSONS & QUIZ CONFIGS
    // =========================================================================

    match /learning_courses/{courseId} {
      allow get: if isValidId(courseId) && (resource.data.status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isAdmin();

      allow create: if isAdmin() &&
                       isValidId(courseId) &&
                       isValidLearningCourse(incoming(), courseId) &&
                       incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
                       isValidId(courseId) &&
                       isValidLearningCourse(incoming(), courseId) &&
                       incoming().id == existing().id &&
                       incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(courseId);

      // Ordered course modules (Publicly readable curriculum, strictly Admin writable)
      match /modules/{moduleId} {
        allow get: if isValidId(courseId) && isValidId(moduleId);
        allow list: if resource.data.courseId == courseId;

        allow create: if isAdmin() &&
                         isValidId(courseId) &&
                         isValidId(moduleId) &&
                         isValidCourseModule(incoming(), courseId, moduleId) &&
                         incoming().updatedAt == request.time;

        allow update: if isAdmin() &&
                         isValidId(courseId) &&
                         isValidId(moduleId) &&
                         isValidCourseModule(incoming(), courseId, moduleId) &&
                         incoming().id == existing().id &&
                         incoming().courseId == existing().courseId &&
                         incoming().updatedAt == request.time;

        allow delete: if isAdmin() && isValidId(courseId) && isValidId(moduleId);
      }

      // Course lessons & YouTube video metadata (Publicly readable curriculum, strictly Admin writable)
      match /lessons/{lessonId} {
        allow get: if isValidId(courseId) && isValidId(lessonId);
        allow list: if resource.data.courseId == courseId;

        allow create: if isAdmin() &&
                         isValidId(courseId) &&
                         isValidId(lessonId) &&
                         isValidCourseLesson(incoming(), courseId, lessonId) &&
                         incoming().updatedAt == request.time;

        allow update: if isAdmin() &&
                         isValidId(courseId) &&
                         isValidId(lessonId) &&
                         isValidCourseLesson(incoming(), courseId, lessonId) &&
                         incoming().id == existing().id &&
                         incoming().courseId == existing().courseId &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'moduleId',
                           'title',
                           'description',
                           'videoUrl',
                           'videos',
                           'writtenContent',
                           'exerciseTitle',
                           'exerciseInstructions',
                           'exerciseDeliverable',
                           'attachments',
                           'order',
                           'estimatedMinutes',
                           'updatedBy',
                           'updatedAt'
                         ]);

        allow delete: if isAdmin() && isValidId(courseId) && isValidId(lessonId);
      }

      // PRESERVED: Admin-Only Quiz & Final Assessment Configurations (Answer keys strictly hidden)
      match /quiz_configs/{quizId} {
        allow get: if isAdmin() && isValidId(courseId) && isValidId(quizId);
        allow list: if isAdmin() && resource.data.courseId == courseId;

        allow create: if isAdmin() &&
                         isValidId(courseId) &&
                         isValidId(quizId) &&
                         isValidQuizConfig(incoming(), courseId, quizId) &&
                         incoming().updatedAt == request.time;

        allow update: if isAdmin() &&
                         isValidId(courseId) &&
                         isValidId(quizId) &&
                         isValidQuizConfig(incoming(), courseId, quizId) &&
                         incoming().id == existing().id &&
                         incoming().courseId == existing().courseId &&
                         incoming().updatedAt == request.time;

        allow delete: if isAdmin() && isValidId(courseId) && isValidId(quizId);
      }
    }

    // =========================================================================
    // PRESERVED: ADMIN-MANAGED CERTIFICATE TEMPLATES
    // =========================================================================

    match /certificate_templates/{templateId} {
      allow get: if isValidId(templateId);
      allow list: if true;

      allow create: if isAdmin() &&
                       isValidId(templateId) &&
                       isValidCertificateTemplate(incoming(), templateId) &&
                       incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
                       isValidId(templateId) &&
                       isValidCertificateTemplate(incoming(), templateId) &&
                       incoming().id == existing().id &&
                       incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(templateId);
    }

    // =========================================================================
    // PRESERVED: NARROWLY-SCOPED ADMIN-ONLY COLLECTIONGROUP AUDIT RULES
    // =========================================================================

    match /{path=**}/course_enrolments/{courseId} {
      allow read: if isAdmin();
    }

    match /{path=**}/video_progress/{progressKey} {
      allow read: if isAdmin();
    }

    match /{path=**}/assessment_attempts/{attemptId} {
      allow read: if isAdmin();
    }

    match /{path=**}/certificates/{courseId} {
      allow read: if isAdmin();
    }

    // Connection health check document (locked to authenticated users; no anonymous open read)
    match /test/connection {
      allow read: if isSignedIn();
    }
  }
}
