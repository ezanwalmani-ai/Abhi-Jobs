# ==============================================================================
# ABHI JOBS — Environment Variables Template (NAMES ONLY — NEVER COMMIT SECRETS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Single-Backend Public Configuration (Netlify / Vite Frontend)
#    Primary project config lives in firebase-applet-config.json:
#      Project ID:  geometric-centaur-c6pck
#      Database ID: ai-studio-jobhunnar-1b523c26-3c4c-4428-9065-5f763d85c23d
# ------------------------------------------------------------------------------
# Optional: Opt-in Firebase App Check (reCAPTCHA v3 public site key).
# Leave empty until Firebase App Check is enabled in the Firebase Console.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# ------------------------------------------------------------------------------
# 2. Legacy Supabase Frontend Variables (RETAINED UNTIL POST-CUTOVER RETIREMENT)
#    Do not remove until Firebase production cutover is verified and approved.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
# Preferred modern Supabase publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback alias (only if needed by legacy clients)
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 3. Server-Only Migration & Legacy Dev Secrets
#    CRITICAL: NEVER prefix with VITE_, NEVER expose in browser code,
#    NEVER commit values to Git or share in chat.
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Preferred modern Supabase Secret Key (sb_secret_...) for privileged migration export
SUPABASE_SECRET_KEY=
# Alternative legacy Service Role JWT key (used as fallback if SUPABASE_SECRET_KEY is unset)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# Cryptographic HMAC signing secrets (minimum 32 random chars; used by dev server / future Blaze Functions)
LEARNING_SIGNING_SECRET=
CERTIFICATE_SIGNING_SECRET=

# Comma-separated browser origins allowed by CORS
# Example: https://abhijobs.netlify.app,http://localhost:3000
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 4. Transitional / Dev Server Variables
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
ADMIN_ASSESSMENT_PASSCODE=
ADMIN_ASSESSMENT_SESSION_SECRET=
