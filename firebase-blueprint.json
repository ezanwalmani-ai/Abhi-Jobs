{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID (auth UID)", "maxLength": 128 },
        "name": { "type": "string", "description": "User display name", "maxLength": 100 },
        "email": { "type": "string", "description": "User email address", "maxLength": 150 },
        "role": { "type": "string", "description": "Role in platform", "enum": ["job_seeker", "employer", "admin"] },
        "avatar": { "type": "string", "description": "Avatar URL", "maxLength": 500 },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation", "maxLength": 64 },
        "lastActive": { "type": "string", "description": "Last active timestamp or label", "maxLength": 50 },
        "status": { "type": "string", "description": "Account status", "enum": ["active", "suspended"] }
      },
      "required": ["id", "name", "email", "role"]
    },
    "CareerAssessment": {
      "title": "CareerAssessment",
      "description": "Private job seeker profile evaluation test responses and calculated readiness report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Assessment document ID", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "description": "Authenticated candidate UID", "maxLength": 128 },
        "status": { "type": "string", "description": "Assessment lifecycle state", "enum": ["in_progress", "submitted"] },
        "currentStep": { "type": "number", "description": "Last active step index (0-6)" },
        "basicInfo": { "type": "object", "description": "Section A: Basic information" },
        "education": { "type": "object", "description": "Section B: Education details" },
        "experience": { "type": "object", "description": "Section C: Professional experience" },
        "careerPreferences": { "type": "object", "description": "Section D: Career goals and preferences" },
        "skillsEvaluation": { "type": "object", "description": "Section E: Self-evaluated 9 skills" },
        "practicalAnswers": { "type": "object", "description": "Section F: Multiple-choice answers keyed by question ID" },
        "learningRecommendationConsent": { "type": "boolean", "description": "Consent to use responses for course recommendations" },
        "recruitmentConsent": { "type": "boolean", "description": "Explicit optional opt-in for recruitment review" },
        "report": { "type": "object", "description": "Calculated Career Readiness Report upon submission" },
        "createdAt": { "type": "string", "description": "Server timestamp of creation" },
        "updatedAt": { "type": "string", "description": "Server timestamp of last update" },
        "submittedAt": { "type": "string", "description": "ISO timestamp of submission", "maxLength": 64 }
      },
      "required": [
        "id",
        "userId",
        "status",
        "currentStep",
        "basicInfo",
        "education",
        "experience",
        "careerPreferences",
        "skillsEvaluation",
        "practicalAnswers",
        "learningRecommendationConsent",
        "recruitmentConsent",
        "createdAt",
        "updatedAt"
      ]
    },
    "CourseEnrolment": {
      "title": "CourseEnrolment",
      "description": "Candidate enrolment and learning progress record for a Learn with ABHI course, keyed by courseId to prevent duplicates",
      "type": "object",
      "properties": {
        "courseId": { "type": "string", "description": "Unique catalogue course ID", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseSlug": { "type": "string", "description": "Course URL slug", "maxLength": 128 },
        "courseTitle": { "type": "string", "description": "Course display title", "maxLength": 160 },
        "categoryId": { "type": "string", "description": "Course category identifier", "maxLength": 80 },
        "userId": { "type": "string", "description": "Authenticated candidate UID", "maxLength": 128 },
        "status": { "type": "string", "description": "Learning progress status", "enum": ["enrolled", "in_progress", "completed"] },
        "currentLessonId": { "type": "string", "description": "Last viewed lesson ID for resuming", "maxLength": 128 },
        "completedLessonIds": { "type": "array", "description": "Bounded list of completed lesson IDs (max 200)" },
        "passedModuleQuizIds": { "type": "array", "description": "Bounded list of module IDs whose required quizzes are passed (max 40)" },
        "finalAssessmentPassed": { "type": "boolean", "description": "Whether the final course assessment was passed at or above pass threshold" },
        "bestFinalScorePercent": { "type": "number", "description": "Highest final assessment score percentage achieved (0-100)" },
        "progressPercent": { "type": "number", "description": "Calculated overall course completion percentage (0-100)" },
        "enrolledAt": { "type": "string", "description": "Server timestamp of initial enrolment" },
        "lastAccessedAt": { "type": "string", "description": "Server timestamp of last lesson access or progress save" },
        "completedAt": { "type": "string", "description": "ISO timestamp when all lessons, required quizzes, and final assessment passed", "maxLength": 64 }
      },
      "required": [
        "courseId",
        "courseSlug",
        "courseTitle",
        "categoryId",
        "userId",
        "status",
        "completedLessonIds",
        "progressPercent",
        "enrolledAt",
        "lastAccessedAt"
      ]
    },
    "AssessmentAttempt": {
      "title": "AssessmentAttempt",
      "description": "Private server-graded quiz or final assessment attempt belonging strictly to an authenticated candidate",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Attempt document ID", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "description": "Authenticated candidate UID", "maxLength": 128 },
        "courseId": { "type": "string", "description": "Course identifier", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseSlug": { "type": "string", "description": "Course URL slug", "maxLength": 128 },
        "courseTitle": { "type": "string", "description": "Course title", "maxLength": 160 },
        "assessmentType": { "type": "string", "description": "Quiz vs final assessment", "enum": ["module_quiz", "final_assessment"] },
        "moduleId": { "type": "string", "description": "Module ID for module quizzes", "maxLength": 128 },
        "assessmentTitle": { "type": "string", "description": "Display title of the quiz or final assessment", "maxLength": 180 },
        "attemptNumber": { "type": "number", "description": "Sequential attempt counter (>= 1)" },
        "totalQuestions": { "type": "number", "description": "Total questions graded" },
        "correctAnswers": { "type": "number", "description": "Count of correct answers" },
        "incorrectAnswers": { "type": "number", "description": "Count of incorrect answers" },
        "scorePercent": { "type": "number", "description": "Percentage score (0-100)" },
        "passPercentage": { "type": "number", "description": "Required passing score percentage (0-100)" },
        "passed": { "type": "boolean", "description": "Whether attempt met or exceeded passPercentage" },
        "answers": { "type": "object", "description": "Map of questionId to selected option index (0-3)" },
        "questionResults": { "type": "array", "description": "Post-submission graded review items with explanations (max 30)" },
        "submittedAt": { "type": "string", "description": "Server timestamp of graded submission" }
      },
      "required": [
        "id",
        "userId",
        "courseId",
        "courseSlug",
        "courseTitle",
        "assessmentType",
        "assessmentTitle",
        "attemptNumber",
        "totalQuestions",
        "correctAnswers",
        "incorrectAnswers",
        "scorePercent",
        "passPercentage",
        "passed",
        "answers",
        "questionResults",
        "submittedAt"
      ]
    },
    "CourseQuizConfig": {
      "title": "CourseQuizConfig",
      "description": "Admin-only quiz and final assessment configuration including answer keys and explanations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Quiz configuration ID", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseId": { "type": "string", "description": "Parent course ID", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assessmentType": { "type": "string", "description": "Module quiz or final assessment", "enum": ["module_quiz", "final_assessment"] },
        "moduleId": { "type": "string", "description": "Target module ID for module quizzes", "maxLength": 128 },
        "title": { "type": "string", "description": "Assessment display title", "maxLength": 180 },
        "passPercentage": { "type": "number", "description": "Passing threshold (1-100)" },
        "questionCount": { "type": "number", "description": "Number of questions served per attempt (1-30)" },
        "randomizeOrder": { "type": "boolean", "description": "Whether to shuffle question order" },
        "requiredForCompletion": { "type": "boolean", "description": "Whether passing is required to complete course" },
        "questions": { "type": "array", "description": "Bounded question bank array (max 50)" },
        "updatedBy": { "type": "string", "description": "Admin UID", "maxLength": 128 },
        "updatedAt": { "type": "string", "description": "Server timestamp of update" }
      },
      "required": [
        "id",
        "courseId",
        "assessmentType",
        "title",
        "passPercentage",
        "questionCount",
        "randomizeOrder",
        "requiredForCompletion",
        "questions",
        "updatedBy",
        "updatedAt"
      ]
    },
    "CourseLessonContent": {
      "title": "CourseLessonContent",
      "description": "Admin-managed lesson content, embedded video URL, written material, exercise, and attachments for a Learn with ABHI course",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Lesson document ID", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseId": { "type": "string", "description": "Parent course ID", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "moduleId": { "type": "string", "description": "Parent module ID", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "description": "Lesson display title", "maxLength": 160 },
        "description": { "type": "string", "description": "Short lesson summary", "maxLength": 600 },
        "videoUrl": { "type": "string", "description": "Optional HTTPS embedded video URL", "maxLength": 500 },
        "writtenContent": { "type": "string", "description": "Structured written learning material", "maxLength": 20000 },
        "exerciseTitle": { "type": "string", "description": "Practical exercise heading", "maxLength": 200 },
        "exerciseInstructions": { "type": "string", "description": "Practical exercise instructions", "maxLength": 4000 },
        "exerciseDeliverable": { "type": "string", "description": "Optional exercise output description", "maxLength": 500 },
        "attachments": { "type": "array", "description": "Bounded list of downloadable resource objects (max 15)" },
        "order": { "type": "number", "description": "Lesson sequence order within module (1-200)" },
        "estimatedMinutes": { "type": "number", "description": "Estimated study time in minutes (1-300)" },
        "updatedBy": { "type": "string", "description": "Admin UID who last updated the lesson", "maxLength": 128 },
        "updatedAt": { "type": "string", "description": "Server timestamp of last update" }
      },
      "required": [
        "id",
        "courseId",
        "moduleId",
        "title",
        "description",
        "writtenContent",
        "attachments",
        "order",
        "estimatedMinutes",
        "updatedBy",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection indexed by auth UID"
    },
    "/users/{userId}/career_assessments/{assessmentId}": {
      "schema": "CareerAssessment",
      "description": "Private per-candidate Job Seeker Profile Evaluation Test drafts and submitted reports"
    },
    "/users/{userId}/course_enrolments/{courseId}": {
      "schema": "CourseEnrolment",
      "description": "Private per-candidate Learn with ABHI course enrolments, lesson progress, and completion state keyed by courseId"
    },
    "/users/{userId}/assessment_attempts/{attemptId}": {
      "schema": "AssessmentAttempt",
      "description": "Private per-candidate server-graded quiz and final assessment attempt records"
    },
    "/learning_courses/{courseId}/lessons/{lessonId}": {
      "schema": "CourseLessonContent",
      "description": "Admin-managed Learn with ABHI lesson content, video URLs, exercises, and downloadable attachments"
    },
    "/learning_courses/{courseId}/quiz_configs/{quizId}": {
      "schema": "CourseQuizConfig",
      "description": "Admin-only quiz and final assessment definitions including answer keys and explanations"
    }
  }
}
