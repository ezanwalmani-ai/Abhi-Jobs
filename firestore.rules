rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // HARDENED GLOBAL PRIMITIVES & 5-ROLE RBAC HELPERS (Pillars 3, 4 & 8)
    // =========================================================================

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHexSignature(sig) {
      return sig is string && sig.size() >= 32 && sig.size() <= 128 && sig.matches('^[a-fA-F0-9]{32,128}$');
    }

    function isValidYouTubeId(ytId) {
      return ytId is string && ytId.size() == 11 && ytId.matches('^[a-zA-Z0-9_\\-]{11}$');
    }

    function isValidHexColor(color) {
      return color is string && color.size() == 7 && color.matches('^#[0-9A-Fa-f]{6}$');
    }

    function isValidCertificateId(certId) {
      return certId is string && certId.size() >= 8 && certId.size() <= 64 && certId.matches('^[A-Z0-9\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Root Super Admin bootstrap guard (strictly requires verified email token).
    // Manual provisioning of /admin_roles/{uid} for ezanwalmani@gmail.com is documented
    // in firebase/PHASE_2B_ARCHITECTURE_AND_PROVISIONING.md. Zero client self-escalation.
    function isBootstrapSuperAdmin() {
      return isVerifiedUser() &&
             request.auth.token.email == 'ezanwalmani@gmail.com';
    }

    function hasRoleIn(roleData, allowedRoles) {
      return roleData.status == 'active' && roleData.role in allowedRoles;
    }

    function hasActiveAdminRole(allowedRoles) {
      return isVerifiedUser() &&
             exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid)) &&
             hasRoleIn(get(/databases/$(database)/documents/admin_roles/$(request.auth.uid)).data, allowedRoles);
    }

    function isSuperAdmin() {
      return isBootstrapSuperAdmin() || hasActiveAdminRole(['super_admin']);
    }

    function isRecruitmentAdmin() {
      return isBootstrapSuperAdmin() || hasActiveAdminRole(['super_admin', 'recruitment_admin']);
    }

    function isCourseAdmin() {
      return isBootstrapSuperAdmin() || hasActiveAdminRole(['super_admin', 'course_admin']);
    }

    function isContentAdmin() {
      return isBootstrapSuperAdmin() || hasActiveAdminRole(['super_admin', 'content_admin']);
    }

    function isSupportAdmin() {
      return isBootstrapSuperAdmin() || hasActiveAdminRole(['super_admin', 'support_admin']);
    }

    function isAnyAdmin() {
      return isBootstrapSuperAdmin() ||
             hasActiveAdminRole(['super_admin', 'recruitment_admin', 'course_admin', 'content_admin', 'support_admin']);
    }

    // Backward-compatible Learn with ABHI admin helper:
    // Preserves legacy /admins/{uid} compatibility alongside course_admin & super_admin.
    function isAdmin() {
      return isCourseAdmin() ||
             (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Employer verification helpers (O(1) constant path keyed by owner Firebase Auth UID, single get())
    function employerMatchesStatuses(empData, allowedStatuses) {
      return empData.ownerUid == request.auth.uid &&
             empData.verificationStatus in allowedStatuses;
    }

    function isVerifiedEmployer() {
      return isVerifiedUser() &&
             exists(/databases/$(database)/documents/employers/$(request.auth.uid)) &&
             employerMatchesStatuses(
               get(/databases/$(database)/documents/employers/$(request.auth.uid)).data,
               ['verified']
             );
    }

    function isActiveNonSuspendedEmployer() {
      return isVerifiedUser() &&
             exists(/databases/$(database)/documents/employers/$(request.auth.uid)) &&
             employerMatchesStatuses(
               get(/databases/$(database)/documents/employers/$(request.auth.uid)).data,
               ['pending', 'verified']
             );
    }

    // Master Gate parent-lookup helpers for isolated subcollections
    function isParentEmployerOwner(employerId) {
      return isVerifiedUser() &&
             exists(/databases/$(database)/documents/employers/$(employerId)) &&
             get(/databases/$(database)/documents/employers/$(employerId)).data.ownerUid == request.auth.uid;
    }

    function isParentApplicationEmployer(applicationId) {
      return isVerifiedUser() &&
             exists(/databases/$(database)/documents/applications/$(applicationId)) &&
             get(/databases/$(database)/documents/applications/$(applicationId)).data.employerOwnerUid == request.auth.uid;
    }

    // Relational sync single-get() helpers for applications and interviews
    function matchesPublishedJob(jobData, appData) {
      return jobData.status == 'published' &&
             jobData.employerId == appData.employerId &&
             jobData.employerOwnerUid == appData.employerOwnerUid;
    }

    function matchesActiveApplication(appData, intData) {
      return !(appData.status in ['Withdrawn', 'Rejected', 'Not Selected']) &&
             appData.candidateId == intData.candidateId &&
             appData.jobId == intData.jobId &&
             appData.employerId == intData.employerId &&
             appData.employerOwnerUid == intData.employerOwnerUid;
    }

    // Job authorization helpers (checked before heavy schema validation to stay well under 1000 expressions)
    function canCreateJobActor(data) {
      return (isVerifiedUser() &&
              data.employerId == request.auth.uid &&
              data.employerOwnerUid == request.auth.uid &&
              data.featured == false &&
              (
                (data.status == 'published' && data.isVerifiedCompany == true && isVerifiedEmployer()) ||
                (data.status == 'draft' && data.isVerifiedCompany == false && isActiveNonSuspendedEmployer())
              )) ||
             isRecruitmentAdmin();
    }

    function canUpdateJobActor(data, prev) {
      return (isVerifiedUser() &&
              prev.employerOwnerUid == request.auth.uid &&
              data.applicantsCount == prev.applicantsCount &&
              data.viewsCount == prev.viewsCount &&
              data.featured == prev.featured &&
              data.isVerifiedCompany == prev.isVerifiedCompany &&
              (data.status != 'published' || isVerifiedEmployer()) &&
              data.diff(prev).affectedKeys().hasOnly([
                'companyName',
                'companyLogo',
                'title',
                'department',
                'industry',
                'location',
                'employmentType',
                'workMode',
                'experienceLevel',
                'minExperienceYears',
                'salary',
                'overview',
                'responsibilities',
                'requirements',
                'preferredSkills',
                'benefits',
                'deadline',
                'status',
                'postedAt',
                'updatedAt'
              ])) ||
             isRecruitmentAdmin();
    }

    // =========================================================================
    // PRESERVED EXISTING VALIDATION BLUEPRINTS (User & CareerAssessment)
    // =========================================================================

    function isValidCandidateCode(code) {
      return code is string && code.size() == 4 && code.matches('^[1-9][0-9]{3}$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role']) &&
             data.keys().hasOnly(['id', 'candidateCode', 'name', 'email', 'role', 'avatar', 'createdAt', 'lastActive', 'status']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             (!('candidateCode' in data) || isValidCandidateCode(data.candidateCode)) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.role is string && (data.role == 'job_seeker' || data.role == 'employer' || data.role == 'admin') &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('lastActive' in data) || (data.lastActive is string && data.lastActive.size() <= 50)) &&
             (!('status' in data) || (data.status is string && (data.status == 'active' || data.status == 'suspended')));
    }

    function isValidCandidateIdRegistry(data, candidateCode) {
      return data.keys().hasAll(['candidateCode', 'userId', 'assignedAt']) &&
             data.keys().hasOnly(['candidateCode', 'userId', 'assignedAt']) &&
             data.candidateCode == candidateCode &&
             isValidCandidateCode(data.candidateCode) &&
             isValidId(data.userId);
    }

    function isValidCandidateDocument(data, uid, docId) {
      return data.keys().hasAll([
               'id',
               'candidateUid',
               'category',
               'originalFilename',
               'mimeType',
               'extension',
               'sizeBytes',
               'versionNumber',
               'isLatest',
               'uploadedByUid',
               'uploadedAt'
             ]) &&
             data.keys().hasOnly([
               'id',
               'candidateUid',
               'category',
               'originalFilename',
               'mimeType',
               'extension',
               'sizeBytes',
               'versionNumber',
               'isLatest',
               'uploadedByUid',
               'uploadedAt',
               'sha256'
             ]) &&
             data.id == docId &&
             isValidId(data.id) &&
             data.candidateUid == uid &&
             data.uploadedByUid == uid &&
             data.category is string && (data.category in ['resume', 'certificate', 'supporting']) &&
             data.originalFilename is string && data.originalFilename.size() > 0 && data.originalFilename.size() <= 180 &&
             data.mimeType is string && data.mimeType.size() > 0 && data.mimeType.size() <= 120 &&
             data.extension is string && data.extension.size() > 0 && data.extension.size() <= 12 &&
             data.sizeBytes is number && data.sizeBytes > 0 && data.sizeBytes <= 10485760 &&
             data.versionNumber is number && data.versionNumber >= 1 && data.versionNumber <= 500 &&
             data.isLatest is bool &&
             (!('sha256' in data) || (data.sha256 is string && data.sha256.size() <= 128));
    }

    function isValidCandidateInternalNote(data, uid, noteId) {
      return data.keys().hasAll(['id', 'candidateUid', 'authorUid', 'authorEmail', 'authorName', 'text', 'createdAt']) &&
             data.keys().hasOnly(['id', 'candidateUid', 'authorUid', 'authorEmail', 'authorName', 'text', 'category', 'createdAt']) &&
             data.id == noteId &&
             isValidId(data.id) &&
             data.candidateUid == uid &&
             data.authorUid == request.auth.uid &&
             data.authorEmail is string && data.authorEmail.size() > 0 && data.authorEmail.size() <= 150 &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 120 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
             (!('category' in data) || (data.category is string && data.category.size() <= 40));
    }

    function isValidAssessment(data, userId, assessmentId) {
      return data.keys().hasAll([
               'id',
               'userId',
               'status',
               'currentStep',
               'basicInfo',
               'education',
               'experience',
               'careerPreferences',
               'skillsEvaluation',
               'practicalAnswers',
               'learningRecommendationConsent',
               'recruitmentConsent',
               'createdAt',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id',
               'userId',
               'status',
               'currentStep',
               'basicInfo',
               'education',
               'experience',
               'careerPreferences',
               'skillsEvaluation',
               'practicalAnswers',
               'learningRecommendationConsent',
               'recruitmentConsent',
               'report',
               'createdAt',
               'updatedAt',
               'submittedAt'
             ]) &&
             data.id == assessmentId &&
             isValidId(data.id) &&
             data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.status is string &&
             (data.status == 'in_progress' || data.status == 'submitted') &&
             data.currentStep is number &&
             data.currentStep >= 0 &&
             data.currentStep <= 7 &&
             data.basicInfo is map &&
             data.basicInfo.size() <= 10 &&
             data.education is map &&
             data.education.size() <= 10 &&
             data.experience is map &&
             data.experience.size() <= 10 &&
             data.careerPreferences is map &&
             data.careerPreferences.size() <= 10 &&
             data.skillsEvaluation is map &&
             data.skillsEvaluation.size() <= 15 &&
             data.practicalAnswers is map &&
             data.practicalAnswers.size() <= 20 &&
             data.learningRecommendationConsent is bool &&
             data.recruitmentConsent is bool &&
             (!('report' in data) || (data.report is map && data.report.size() <= 20)) &&
             (!('submittedAt' in data) || (data.submittedAt is string && data.submittedAt.size() <= 64));
    }

    // =========================================================================
    // PRESERVED LEARN WITH ABHI VALIDATION BLUEPRINTS (Pillar 2 & Pillar 5)
    // =========================================================================

    function isValidLearningCourse(data, courseId) {
      return data.keys().hasAll([
               'id',
               'slug',
               'categoryId',
               'categoryName',
               'title',
               'shortDescription',
               'fullDescription',
               'level',
               'estimatedDuration',
               'isFree',
               'sequentialUnlock',
               'passPercentage',
               'certificateTemplateId',
               'status',
               'moduleCount',
               'courseIntroduction',
               'whatYouWillLearn',
               'skillsDeveloped',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id',
               'slug',
               'categoryId',
               'categoryName',
               'title',
               'shortDescription',
               'fullDescription',
               'level',
               'estimatedDuration',
               'isFree',
               'sequentialUnlock',
               'passPercentage',
               'certificateTemplateId',
               'status',
               'moduleCount',
               'courseIntroduction',
               'whatYouWillLearn',
               'skillsDeveloped',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.id == courseId &&
             isValidId(data.id) &&
             isValidId(data.slug) &&
             data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 80 &&
             data.categoryName is string && data.categoryName.size() > 0 && data.categoryName.size() <= 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
             data.shortDescription is string && data.shortDescription.size() <= 400 &&
             data.fullDescription is string && data.fullDescription.size() <= 4000 &&
             data.level is string && (data.level == 'Beginner' || data.level == 'Intermediate') &&
             data.estimatedDuration is string && data.estimatedDuration.size() <= 64 &&
             data.isFree is bool &&
             data.sequentialUnlock is bool &&
             data.passPercentage is number && data.passPercentage >= 70 && data.passPercentage <= 100 &&
             isValidId(data.certificateTemplateId) &&
             data.status is string && (data.status == 'draft' || data.status == 'published') &&
             data.moduleCount is number && data.moduleCount >= 0 && data.moduleCount <= 50 &&
             data.courseIntroduction is map && data.courseIntroduction.size() <= 10 &&
             data.whatYouWillLearn is list && data.whatYouWillLearn.size() <= 20 &&
             (data.whatYouWillLearn.size() == 0 || (data.whatYouWillLearn[0] is string && data.whatYouWillLearn[0].size() <= 200)) &&
             data.skillsDeveloped is list && data.skillsDeveloped.size() <= 20 &&
             (data.skillsDeveloped.size() == 0 || (data.skillsDeveloped[0] is string && data.skillsDeveloped[0].size() <= 100)) &&
             data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128;
    }

    function isValidCourseModule(data, courseId, moduleId) {
      return data.keys().hasAll([
               'id',
               'courseId',
               'order',
               'title',
               'summary',
               'estimatedMinutes',
               'quizRequired',
               'passPercentage',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id',
               'courseId',
               'order',
               'title',
               'summary',
               'estimatedMinutes',
               'quizRequired',
               'passPercentage',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.id == moduleId &&
             isValidId(data.id) &&
             data.courseId == courseId &&
             isValidId(data.courseId) &&
             data.order is number && data.order >= 1 && data.order <= 50 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
             data.summary is string && data.summary.size() <= 600 &&
             data.estimatedMinutes is number && data.estimatedMinutes >= 1 && data.estimatedMinutes <= 600 &&
             data.quizRequired is bool &&
             data.passPercentage is number && data.passPercentage >= 50 && data.passPercentage <= 100 &&
             data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128;
    }

    function isValidCourseLesson(data, courseId, lessonId) {
      return data.keys().hasAll([
               'id',
               'courseId',
               'moduleId',
               'title',
               'description',
               'writtenContent',
               'attachments',
               'order',
               'estimatedMinutes',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id',
               'courseId',
               'moduleId',
               'title',
               'description',
               'videoUrl',
               'videos',
               'writtenContent',
               'exerciseTitle',
               'exerciseInstructions',
               'exerciseDeliverable',
               'attachments',
               'order',
               'estimatedMinutes',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.id == lessonId &&
             isValidId(data.id) &&
             data.courseId == courseId &&
             isValidId(data.courseId) &&
             isValidId(data.moduleId) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
             data.description is string && data.description.size() <= 600 &&
             (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 500)) &&
             (!('videos' in data) || (
               data.videos is list &&
               data.videos.size() <= 10 &&
               (data.videos.size() == 0 || data.videos[0] is map)
             )) &&
             data.writtenContent is string && data.writtenContent.size() <= 20000 &&
             (!('exerciseTitle' in data) || (data.exerciseTitle is string && data.exerciseTitle.size() <= 200)) &&
             (!('exerciseInstructions' in data) || (data.exerciseInstructions is string && data.exerciseInstructions.size() <= 4000)) &&
             (!('exerciseDeliverable' in data) || (data.exerciseDeliverable is string && data.exerciseDeliverable.size() <= 500)) &&
             data.attachments is list &&
             data.attachments.size() <= 15 &&
             (data.attachments.size() == 0 || data.attachments[0] is map) &&
             data.order is number && data.order >= 1 && data.order <= 200 &&
             data.estimatedMinutes is number && data.estimatedMinutes >= 1 && data.estimatedMinutes <= 300 &&
             data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128;
    }

    function isValidQuizConfig(data, courseId, quizId) {
      return data.keys().hasAll([
               'id',
               'courseId',
               'assessmentType',
               'title',
               'passPercentage',
               'questionCount',
               'randomizeOrder',
               'requiredForCompletion',
               'questions',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id',
               'courseId',
               'assessmentType',
               'moduleId',
               'title',
               'passPercentage',
               'questionCount',
               'randomizeOrder',
               'requiredForCompletion',
               'questions',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.id == quizId &&
             isValidId(data.id) &&
             data.courseId == courseId &&
             isValidId(data.courseId) &&
             data.assessmentType is string && (data.assessmentType == 'module_quiz' || data.assessmentType == 'final_assessment') &&
             (!('moduleId' in data) || (data.moduleId is string && data.moduleId.size() <= 128)) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 180 &&
             data.passPercentage is number && data.passPercentage >= 1 && data.passPercentage <= 100 &&
             data.questionCount is number && data.questionCount >= 1 && data.questionCount <= 30 &&
             data.randomizeOrder is bool &&
             data.requiredForCompletion is bool &&
             data.questions is list && data.questions.size() <= 50 &&
             (data.questions.size() == 0 || data.questions[0] is map) &&
             data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128;
    }

    function isValidCourseEnrolment(data, userId, courseId) {
      return data.keys().hasAll([
               'courseId',
               'courseSlug',
               'courseTitle',
               'categoryId',
               'userId',
               'status',
               'completedLessonIds',
               'passedModuleQuizIds',
               'unlockedModuleOrder',
               'finalAssessmentPassed',
               'progressPercent',
               'enrolledAt',
               'lastAccessedAt'
             ]) &&
             data.keys().hasOnly([
               'courseId',
               'courseSlug',
               'courseTitle',
               'categoryId',
               'userId',
               'status',
               'currentModuleId',
               'currentLessonId',
               'completedLessonIds',
               'completedModuleIds',
               'passedModuleQuizIds',
               'unlockedModuleOrder',
               'lastVerifiedAttemptId',
               'lastVerifiedFinalAttemptId',
               'finalAssessmentPassed',
               'bestFinalScorePercent',
               'progressPercent',
               'enrolledAt',
               'lastAccessedAt',
               'completedAt'
             ]) &&
             data.courseId == courseId &&
             isValidId(data.courseId) &&
             data.courseSlug is string && data.courseSlug.size() > 0 && data.courseSlug.size() <= 128 &&
             data.courseTitle is string && data.courseTitle.size() > 0 && data.courseTitle.size() <= 160 &&
             data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 80 &&
             data.userId is string && data.userId == userId &&
             data.status is string && (data.status == 'enrolled' || data.status == 'in_progress' || data.status == 'completed') &&
             (!('currentModuleId' in data) || (data.currentModuleId is string && data.currentModuleId.size() <= 128)) &&
             (!('currentLessonId' in data) || (data.currentLessonId is string && data.currentLessonId.size() <= 128)) &&
             data.completedLessonIds is list &&
             data.completedLessonIds.size() <= 200 &&
             (data.completedLessonIds.size() == 0 || (data.completedLessonIds[0] is string && data.completedLessonIds[0].size() <= 128)) &&
             (!('completedModuleIds' in data) || (
               data.completedModuleIds is list &&
               data.completedModuleIds.size() <= 40 &&
               (data.completedModuleIds.size() == 0 || (data.completedModuleIds[0] is string && data.completedModuleIds[0].size() <= 128))
             )) &&
             data.passedModuleQuizIds is list &&
             data.passedModuleQuizIds.size() <= 40 &&
             (data.passedModuleQuizIds.size() == 0 || (data.passedModuleQuizIds[0] is string && data.passedModuleQuizIds[0].size() <= 128)) &&
             data.unlockedModuleOrder is number && data.unlockedModuleOrder >= 1 && data.unlockedModuleOrder <= 50 &&
             (!('lastVerifiedAttemptId' in data) || isValidId(data.lastVerifiedAttemptId)) &&
             (!('lastVerifiedFinalAttemptId' in data) || isValidId(data.lastVerifiedFinalAttemptId)) &&
             data.finalAssessmentPassed is bool &&
             (!('bestFinalScorePercent' in data) || (data.bestFinalScorePercent is number && data.bestFinalScorePercent >= 0 && data.bestFinalScorePercent <= 100)) &&
             (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 64)) &&
             data.progressPercent is number &&
             data.progressPercent >= 0 &&
             data.progressPercent <= 100;
    }

    function isValidVideoProgress(data, userId, progressKey) {
      return data.keys().hasAll([
               'id',
               'userId',
               'courseId',
               'lessonId',
               'videoId',
               'youtubeVideoId',
               'durationSeconds',
               'watchedSeconds',
               'maxPercentWatched',
               'lastPositionSeconds',
               'hasPlayed',
               'completedViaPlayer',
               'manualCompleted',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id',
               'userId',
               'courseId',
               'lessonId',
               'videoId',
               'youtubeVideoId',
               'durationSeconds',
               'watchedSeconds',
               'maxPercentWatched',
               'lastPositionSeconds',
               'hasPlayed',
               'completedViaPlayer',
               'manualCompleted',
               'updatedAt'
             ]) &&
             data.id == progressKey &&
             isValidId(data.id) &&
             data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             isValidId(data.courseId) &&
             isValidId(data.lessonId) &&
             isValidId(data.videoId) && data.videoId.size() <= 64 &&
             isValidYouTubeId(data.youtubeVideoId) &&
             data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400 &&
             data.watchedSeconds is number && data.watchedSeconds >= 0 && data.watchedSeconds <= 86400 &&
             data.maxPercentWatched is number && data.maxPercentWatched >= 0 && data.maxPercentWatched <= 100 &&
             data.lastPositionSeconds is number && data.lastPositionSeconds >= 0 && data.lastPositionSeconds <= 86400 &&
             data.hasPlayed is bool &&
             data.completedViaPlayer is bool &&
             data.manualCompleted is bool &&
             (!data.completedViaPlayer || (data.hasPlayed == true && data.maxPercentWatched >= 80));
    }

    function isValidAssessmentAttempt(data, userId, attemptId) {
      return data.keys().hasAll([
               'id',
               'userId',
               'courseId',
               'courseSlug',
               'courseTitle',
               'assessmentType',
               'assessmentTitle',
