rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives (Pillar 3 & Pillar 4)
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHexSignature(sig) {
      return sig is string && sig.size() >= 32 && sig.size() <= 128 && sig.matches('^[a-fA-F0-9]{32,128}$');
    }

    function isValidYouTubeId(ytId) {
      return ytId is string && ytId.size() == 11 && ytId.matches('^[a-zA-Z0-9_\\-]{11}$');
    }

    function isValidHexColor(color) {
      return color is string && color.size() == 7 && color.matches('^#[0-9A-Fa-f]{6}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'ezanwalmani@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // =========================================================================
    // PRESERVED EXISTING VALIDATION BLUEPRINTS (User & CareerAssessment)
    // =========================================================================

    function isValidUser(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.role is string && (data.role == 'job_seeker' || data.role == 'employer' || data.role == 'admin');
    }

    function isValidAssessment(data, userId, assessmentId) {
      return data.keys().hasAll([
               'id',
               'userId',
               'status',
               'currentStep',
               'basicInfo',
               'education',
               'experience',
               'careerPreferences',
               'skillsEvaluation',
               'practicalAnswers',
               'learningRecommendationConsent',
               'recruitmentConsent',
               'createdAt',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id',
               'userId',
               'status',
               'currentStep',
               'basicInfo',
               'education',
               'experience',
               'careerPreferences',
               'skillsEvaluation',
               'practicalAnswers',
               'learningRecommendationConsent',
               'recruitmentConsent',
               'report',
               'createdAt',
               'updatedAt',
               'submittedAt'
             ]) &&
             data.id == assessmentId &&
             isValidId(data.id) &&
             data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.status is string &&
             (data.status == 'in_progress' || data.status == 'submitted') &&
             data.currentStep is number &&
             data.currentStep >= 0 &&
             data.currentStep <= 7 &&
             data.basicInfo is map &&
             data.basicInfo.size() <= 10 &&
             data.education is map &&
             data.education.size() <= 10 &&
             data.experience is map &&
             data.experience.size() <= 10 &&
             data.careerPreferences is map &&
             data.careerPreferences.size() <= 10 &&
             data.skillsEvaluation is map &&
             data.skillsEvaluation.size() <= 15 &&
             data.practicalAnswers is map &&
             data.practicalAnswers.size() <= 20 &&
             data.learningRecommendationConsent is bool &&
             data.recruitmentConsent is bool &&
             (!('report' in data) || (data.report is map && data.report.size() <= 20)) &&
             (!('submittedAt' in data) || (data.submittedAt is string && data.submittedAt.size() <= 64));
    }

    // =========================================================================
    // LEARN WITH ABHI VALIDATION BLUEPRINTS (Pillar 2 & Pillar 5)
    // =========================================================================

    function isValidLearningCourse(data, courseId) {
      return data.keys().hasAll([
               'id',
               'slug',
               'categoryId',
               'categoryName',
               'title',
               'shortDescription',
               'fullDescription',
               'level',
               'estimatedDuration',
               'isFree',
               'sequentialUnlock',
               'passPercentage',
               'certificateTemplateId',
               'status',
               'moduleCount',
               'courseIntroduction',
               'whatYouWillLearn',
               'skillsDeveloped',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id',
               'slug',
               'categoryId',
               'categoryName',
               'title',
               'shortDescription',
               'fullDescription',
               'level',
               'estimatedDuration',
               'isFree',
               'sequentialUnlock',
               'passPercentage',
               'certificateTemplateId',
               'status',
               'moduleCount',
               'courseIntroduction',
               'whatYouWillLearn',
               'skillsDeveloped',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.id == courseId &&
             isValidId(data.id) &&
             isValidId(data.slug) &&
             data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 80 &&
             data.categoryName is string && data.categoryName.size() > 0 && data.categoryName.size() <= 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
             data.shortDescription is string && data.shortDescription.size() <= 400 &&
             data.fullDescription is string && data.fullDescription.size() <= 4000 &&
             data.level is string && (data.level == 'Beginner' || data.level == 'Intermediate') &&
             data.estimatedDuration is string && data.estimatedDuration.size() <= 64 &&
             data.isFree is bool &&
             data.sequentialUnlock is bool &&
             data.passPercentage is number && data.passPercentage >= 70 && data.passPercentage <= 100 &&
             isValidId(data.certificateTemplateId) &&
             data.status is string && (data.status == 'draft' || data.status == 'published') &&
             data.moduleCount is number && data.moduleCount >= 0 && data.moduleCount <= 50 &&
             data.courseIntroduction is map && data.courseIntroduction.size() <= 10 &&
             data.whatYouWillLearn is list && data.whatYouWillLearn.size() <= 20 &&
             (data.whatYouWillLearn.size() == 0 || (data.whatYouWillLearn[0] is string && data.whatYouWillLearn[0].size() <= 200)) &&
             data.skillsDeveloped is list && data.skillsDeveloped.size() <= 20 &&
             (data.skillsDeveloped.size() == 0 || (data.skillsDeveloped[0] is string && data.skillsDeveloped[0].size() <= 100)) &&
             data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128;
    }

    function isValidCourseModule(data, courseId, moduleId) {
      return data.keys().hasAll([
               'id',
               'courseId',
               'order',
               'title',
               'summary',
               'estimatedMinutes',
               'quizRequired',
               'passPercentage',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id',
               'courseId',
               'order',
               'title',
               'summary',
               'estimatedMinutes',
               'quizRequired',
               'passPercentage',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.id == moduleId &&
             isValidId(data.id) &&
             data.courseId == courseId &&
             isValidId(data.courseId) &&
             data.order is number && data.order >= 1 && data.order <= 50 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
             data.summary is string && data.summary.size() <= 600 &&
             data.estimatedMinutes is number && data.estimatedMinutes >= 1 && data.estimatedMinutes <= 600 &&
             data.quizRequired is bool &&
             data.passPercentage is number && data.passPercentage >= 50 && data.passPercentage <= 100 &&
             data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128;
    }

    function isValidCourseLesson(data, courseId, lessonId) {
      return data.keys().hasAll([
               'id',
               'courseId',
               'moduleId',
               'title',
               'description',
               'writtenContent',
               'attachments',
               'order',
               'estimatedMinutes',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id',
               'courseId',
               'moduleId',
               'title',
               'description',
               'videoUrl',
               'videos',
               'writtenContent',
               'exerciseTitle',
               'exerciseInstructions',
               'exerciseDeliverable',
               'attachments',
               'order',
               'estimatedMinutes',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.id == lessonId &&
             isValidId(data.id) &&
             data.courseId == courseId &&
             isValidId(data.courseId) &&
             isValidId(data.moduleId) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
             data.description is string && data.description.size() <= 600 &&
             (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 500)) &&
             (!('videos' in data) || (
               data.videos is list &&
               data.videos.size() <= 10 &&
               (data.videos.size() == 0 || data.videos[0] is map)
             )) &&
             data.writtenContent is string && data.writtenContent.size() <= 20000 &&
             (!('exerciseTitle' in data) || (data.exerciseTitle is string && data.exerciseTitle.size() <= 200)) &&
             (!('exerciseInstructions' in data) || (data.exerciseInstructions is string && data.exerciseInstructions.size() <= 4000)) &&
             (!('exerciseDeliverable' in data) || (data.exerciseDeliverable is string && data.exerciseDeliverable.size() <= 500)) &&
             data.attachments is list &&
             data.attachments.size() <= 15 &&
             (data.attachments.size() == 0 || data.attachments[0] is map) &&
             data.order is number && data.order >= 1 && data.order <= 200 &&
             data.estimatedMinutes is number && data.estimatedMinutes >= 1 && data.estimatedMinutes <= 300 &&
             data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128;
    }

    function isValidQuizConfig(data, courseId, quizId) {
      return data.keys().hasAll([
               'id',
               'courseId',
               'assessmentType',
               'title',
               'passPercentage',
               'questionCount',
               'randomizeOrder',
               'requiredForCompletion',
               'questions',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id',
               'courseId',
               'assessmentType',
               'moduleId',
               'title',
               'passPercentage',
               'questionCount',
               'randomizeOrder',
               'requiredForCompletion',
               'questions',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.id == quizId &&
             isValidId(data.id) &&
             data.courseId == courseId &&
             isValidId(data.courseId) &&
             data.assessmentType is string && (data.assessmentType == 'module_quiz' || data.assessmentType == 'final_assessment') &&
             (!('moduleId' in data) || (data.moduleId is string && data.moduleId.size() <= 128)) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 180 &&
             data.passPercentage is number && data.passPercentage >= 1 && data.passPercentage <= 100 &&
             data.questionCount is number && data.questionCount >= 1 && data.questionCount <= 30 &&
             data.randomizeOrder is bool &&
             data.requiredForCompletion is bool &&
             data.questions is list && data.questions.size() <= 50 &&
             (data.questions.size() == 0 || data.questions[0] is map) &&
             data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128;
    }

    function isValidCourseEnrolment(data, userId, courseId) {
      return data.keys().hasAll([
               'courseId',
               'courseSlug',
               'courseTitle',
               'categoryId',
               'userId',
               'status',
               'completedLessonIds',
               'passedModuleQuizIds',
               'unlockedModuleOrder',
               'finalAssessmentPassed',
               'progressPercent',
               'enrolledAt',
               'lastAccessedAt'
             ]) &&
             data.keys().hasOnly([
               'courseId',
               'courseSlug',
               'courseTitle',
               'categoryId',
               'userId',
               'status',
               'currentModuleId',
               'currentLessonId',
               'completedLessonIds',
               'completedModuleIds',
               'passedModuleQuizIds',
               'unlockedModuleOrder',
               'lastVerifiedAttemptId',
               'lastVerifiedFinalAttemptId',
               'finalAssessmentPassed',
               'bestFinalScorePercent',
               'progressPercent',
               'enrolledAt',
               'lastAccessedAt',
               'completedAt'
             ]) &&
             data.courseId == courseId &&
             isValidId(data.courseId) &&
             data.courseSlug is string && data.courseSlug.size() > 0 && data.courseSlug.size() <= 128 &&
             data.courseTitle is string && data.courseTitle.size() > 0 && data.courseTitle.size() <= 160 &&
             data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 80 &&
             data.userId is string && data.userId == userId &&
             data.status is string && (data.status == 'enrolled' || data.status == 'in_progress' || data.status == 'completed') &&
             (!('currentModuleId' in data) || (data.currentModuleId is string && data.currentModuleId.size() <= 128)) &&
             (!('currentLessonId' in data) || (data.currentLessonId is string && data.currentLessonId.size() <= 128)) &&
             data.completedLessonIds is list &&
             data.completedLessonIds.size() <= 200 &&
             (data.completedLessonIds.size() == 0 || (data.completedLessonIds[0] is string && data.completedLessonIds[0].size() <= 128)) &&
             (!('completedModuleIds' in data) || (
               data.completedModuleIds is list &&
               data.completedModuleIds.size() <= 40 &&
               (data.completedModuleIds.size() == 0 || (data.completedModuleIds[0] is string && data.completedModuleIds[0].size() <= 128))
             )) &&
             data.passedModuleQuizIds is list &&
             data.passedModuleQuizIds.size() <= 40 &&
             (data.passedModuleQuizIds.size() == 0 || (data.passedModuleQuizIds[0] is string && data.passedModuleQuizIds[0].size() <= 128)) &&
             data.unlockedModuleOrder is number && data.unlockedModuleOrder >= 1 && data.unlockedModuleOrder <= 50 &&
             (!('lastVerifiedAttemptId' in data) || isValidId(data.lastVerifiedAttemptId)) &&
             (!('lastVerifiedFinalAttemptId' in data) || isValidId(data.lastVerifiedFinalAttemptId)) &&
             data.finalAssessmentPassed is bool &&
             (!('bestFinalScorePercent' in data) || (data.bestFinalScorePercent is number && data.bestFinalScorePercent >= 0 && data.bestFinalScorePercent <= 100)) &&
             (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 64)) &&
             data.progressPercent is number &&
             data.progressPercent >= 0 &&
             data.progressPercent <= 100;
    }

    function isValidVideoProgress(data, userId, progressKey) {
      return data.keys().hasAll([
               'id',
               'userId',
               'courseId',
               'lessonId',
               'videoId',
               'youtubeVideoId',
               'durationSeconds',
               'watchedSeconds',
               'maxPercentWatched',
               'lastPositionSeconds',
               'hasPlayed',
               'completedViaPlayer',
               'manualCompleted',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id',
               'userId',
               'courseId',
               'lessonId',
               'videoId',
               'youtubeVideoId',
               'durationSeconds',
               'watchedSeconds',
               'maxPercentWatched',
               'lastPositionSeconds',
               'hasPlayed',
               'completedViaPlayer',
               'manualCompleted',
               'updatedAt'
             ]) &&
             data.id == progressKey &&
             isValidId(data.id) &&
             data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             isValidId(data.courseId) &&
             isValidId(data.lessonId) &&
             isValidId(data.videoId) && data.videoId.size() <= 64 &&
             isValidYouTubeId(data.youtubeVideoId) &&
             data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400 &&
             data.watchedSeconds is number && data.watchedSeconds >= 0 && data.watchedSeconds <= 86400 &&
             data.maxPercentWatched is number && data.maxPercentWatched >= 0 && data.maxPercentWatched <= 100 &&
             data.lastPositionSeconds is number && data.lastPositionSeconds >= 0 && data.lastPositionSeconds <= 86400 &&
             data.hasPlayed is bool &&
             data.completedViaPlayer is bool &&
             data.manualCompleted is bool &&
             (!data.completedViaPlayer || (data.hasPlayed == true && data.maxPercentWatched >= 80));
    }

    function isValidAssessmentAttempt(data, userId, attemptId) {
      return data.keys().hasAll([
               'id',
               'userId',
               'courseId',
               'courseSlug',
               'courseTitle',
               'assessmentType',
               'assessmentTitle',
               'attemptNumber',
               'totalQuestions',
               'correctAnswers',
               'incorrectAnswers',
               'scorePercent',
               'passPercentage',
               'passed',
               'answers',
               'questionResults',
               'verificationSignature',
               'submittedAt'
             ]) &&
             data.keys().hasOnly([
               'id',
               'userId',
               'courseId',
               'courseSlug',
               'courseTitle',
               'assessmentType',
               'moduleId',
               'assessmentTitle',
               'attemptNumber',
               'totalQuestions',
               'correctAnswers',
               'incorrectAnswers',
               'scorePercent',
               'passPercentage',
               'passed',
               'answers',
               'questionResults',
               'verificationSignature',
               'submittedAt'
             ]) &&
             data.id == attemptId &&
             isValidId(data.id) &&
             data.userId is string && data.userId == userId &&
             isValidId(data.courseId) &&
             data.courseSlug is string && data.courseSlug.size() > 0 && data.courseSlug.size() <= 128 &&
             data.courseTitle is string && data.courseTitle.size() > 0 && data.courseTitle.size() <= 160 &&
             data.assessmentType is string && (data.assessmentType == 'module_quiz' || data.assessmentType == 'final_assessment') &&
             (!('moduleId' in data) || (data.moduleId is string && data.moduleId.size() <= 128)) &&
             data.assessmentTitle is string && data.assessmentTitle.size() > 0 && data.assessmentTitle.size() <= 180 &&
             data.attemptNumber is number && data.attemptNumber >= 1 && data.attemptNumber <= 500 &&
             data.totalQuestions is number && data.totalQuestions >= 1 && data.totalQuestions <= 30 &&
             data.correctAnswers is number && data.correctAnswers >= 0 && data.correctAnswers <= data.totalQuestions &&
             data.incorrectAnswers is number && data.incorrectAnswers >= 0 && data.incorrectAnswers <= data.totalQuestions &&
             (data.correctAnswers + data.incorrectAnswers == data.totalQuestions) &&
             data.scorePercent is number && data.scorePercent >= 0 && data.scorePercent <= 100 &&
             data.passPercentage is number && data.passPercentage >= 1 && data.passPercentage <= 100 &&
             data.passed is bool &&
             data.passed == (data.scorePercent >= data.passPercentage) &&
             data.answers is map && data.answers.size() <= 30 &&
             data.questionResults is list && data.questionResults.size() <= 30 &&
             (data.questionResults.size() == 0 || data.questionResults[0] is map) &&
             isValidHexSignature(data.verificationSignature);
    }

    function isValidCertificateId(certId) {
      return certId is string && certId.size() >= 8 && certId.size() <= 64 && certId.matches('^[A-Z0-9\\-]+$');
    }

    function isValidCandidateCertificate(data, userId, courseId) {
      return data.keys().hasAll([
               'certificateId',
               'userId',
               'candidateName',
               'courseId',
               'courseSlug',
               'courseTitle',
               'completionDate',
               'finalAssessmentScore',
               'finalAttemptId',
               'templateId',
               'status',
               'verificationSignature',
               'issuedAt'
             ]) &&
             data.keys().hasOnly([
               'certificateId',
               'userId',
               'candidateName',
               'courseId',
               'courseSlug',
               'courseTitle',
               'completionDate',
               'finalAssessmentScore',
               'finalAttemptId',
               'templateId',
               'status',
               'verificationSignature',
               'issuedAt'
             ]) &&
             isValidCertificateId(data.certificateId) &&
             data.userId is string && data.userId == userId &&
             data.candidateName is string && data.candidateName.size() > 0 && data.candidateName.size() <= 120 &&
             data.courseId == courseId && isValidId(data.courseId) &&
             data.courseSlug is string && data.courseSlug.size() > 0 && data.courseSlug.size() <= 128 &&
             data.courseTitle is string && data.courseTitle.size() > 0 && data.courseTitle.size() <= 160 &&
             data.completionDate is string && data.completionDate.size() > 0 && data.completionDate.size() <= 64 &&
             data.finalAssessmentScore is number && data.finalAssessmentScore >= 70 && data.finalAssessmentScore <= 100 &&
             isValidId(data.finalAttemptId) &&
             isValidId(data.templateId) &&
             data.status is string && (data.status == 'valid' || data.status == 'revoked') &&
             isValidHexSignature(data.verificationSignature);
    }

    function isValidPublicCertificate(data, certId) {
      return data.keys().hasAll([
               'certificateId',
               'candidateName',
               'courseId',
               'courseTitle',
               'issueDate',
               'status',
               'issuedAt'
             ]) &&
             data.keys().hasOnly([
               'certificateId',
               'candidateName',
               'courseId',
               'courseTitle',
               'issueDate',
               'status',
               'issuedAt'
             ]) &&
             data.certificateId == certId &&
             isValidCertificateId(data.certificateId) &&
             data.candidateName is string && data.candidateName.size() > 0 && data.candidateName.size() <= 120 &&
             isValidId(data.courseId) &&
             data.courseTitle is string && data.courseTitle.size() > 0 && data.courseTitle.size() <= 160 &&
             data.issueDate is string && data.issueDate.size() > 0 && data.issueDate.size() <= 64 &&
             data.status is string && (data.status == 'valid' || data.status == 'revoked');
    }

    function isValidCertificateTemplate(data, templateId) {
      return data.keys().hasAll([
               'id',
               'name',
               'organizationName',
               'certificateTitle',
               'subtitle',
               'signatoryName',
               'signatoryDesignation',
               'primaryColor',
               'accentColor',
               'isDefault',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id',
               'name',
               'organizationName',
               'certificateTitle',
               'subtitle',
               'signatoryName',
               'signatoryDesignation',
               'primaryColor',
               'accentColor',
               'isDefault',
               'updatedBy',
               'updatedAt'
             ]) &&
             data.id == templateId &&
             isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.organizationName is string && data.organizationName.size() > 0 && data.organizationName.size() <= 120 &&
             data.certificateTitle is string && data.certificateTitle.size() > 0 && data.certificateTitle.size() <= 120 &&
             data.subtitle is string && data.subtitle.size() <= 240 &&
             data.signatoryName is string && data.signatoryName.size() <= 100 &&
             data.signatoryDesignation is string && data.signatoryDesignation.size() <= 120 &&
             isValidHexColor(data.primaryColor) &&
             isValidHexColor(data.accentColor) &&
             data.isDefault is bool &&
             data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128;
    }

    // =========================================================================
    // ADMINS REGISTRY (Console/Server-managed only; prevents privilege escalation)
    // =========================================================================

    match /admins/{adminId} {
      allow read, write: if false;
    }

    // =========================================================================
    // USERS COLLECTION & PRIVATE SUBCOLLECTIONS (Pillar 6: PII Isolation)
    // =========================================================================

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().id == request.auth.uid &&
                       isValidUser(incoming()) &&
                       incoming().role == 'job_seeker';
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().id == existing().id &&
                       isValidUser(incoming()) &&
                       incoming().role == existing().role &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'lastActive', 'status']);
      allow delete: if false;

      // PRESERVED: Private per-candidate Career Profile Evaluation Assessments
      match /career_assessments/{assessmentId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(assessmentId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(assessmentId) &&
                         isValidAssessment(incoming(), userId, assessmentId) &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time;

        allow update: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(assessmentId) &&
                         isValidAssessment(incoming(), userId, assessmentId) &&
                         existing().status == 'in_progress' &&
                         incoming().userId == existing().userId &&
                         incoming().id == existing().id &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt == request.time &&
                         (
                           (incoming().status == 'in_progress' &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'currentStep',
                               'basicInfo',
                               'education',
                               'experience',
                               'careerPreferences',
                               'skillsEvaluation',
                               'practicalAnswers',
                               'learningRecommendationConsent',
                               'recruitmentConsent',
                               'updatedAt'
                             ])) ||
                           (incoming().status == 'submitted' &&
                             incoming().learningRecommendationConsent == true &&
                             'report' in incoming() &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'status',
                               'currentStep',
                               'basicInfo',
                               'education',
                               'experience',
                               'careerPreferences',
                               'skillsEvaluation',
                               'practicalAnswers',
                               'learningRecommendationConsent',
                               'recruitmentConsent',
                               'report',
                               'submittedAt',
                               'updatedAt'
                             ]))
                         );

        allow delete: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(assessmentId) &&
                         existing().status == 'in_progress';
      }

      // HARDENED (ZERO STUDENT SCORE/UNLOCK/COMPLETION WRITES):
      // Students may create a clean initial enrolment and update ONLY non-authoritative
      // lesson resume/completion bookmarks. Quiz passes, module unlocks, final assessment
      // scores, and 'completed' status CANNOT be written by students — only Admins or
      // server-side privileged Admin SDK may modify them.
      match /course_enrolments/{courseId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(courseId);
        allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAdmin();

        allow create: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(courseId) &&
                         isValidCourseEnrolment(incoming(), userId, courseId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().status == 'enrolled' &&
                         incoming().completedLessonIds.size() == 0 &&
                         (!('completedModuleIds' in incoming()) || incoming().completedModuleIds.size() == 0) &&
                         incoming().passedModuleQuizIds.size() == 0 &&
                         incoming().unlockedModuleOrder == 1 &&
                         incoming().finalAssessmentPassed == false &&
                         incoming().progressPercent == 0 &&
                         !('completedAt' in incoming()) &&
                         !('bestFinalScorePercent' in incoming()) &&
                         !('lastVerifiedAttemptId' in incoming()) &&
                         !('lastVerifiedFinalAttemptId' in incoming()) &&
                         incoming().enrolledAt == request.time &&
                         incoming().lastAccessedAt == request.time;

        allow update: if isValidId(userId) &&
                         isValidId(courseId) &&
                         isValidCourseEnrolment(incoming(), userId, courseId) &&
                         incoming().courseId == existing().courseId &&
                         incoming().courseSlug == existing().courseSlug &&
                         incoming().courseTitle == existing().courseTitle &&
                         incoming().categoryId == existing().categoryId &&
                         incoming().userId == existing().userId &&
                         incoming().enrolledAt == existing().enrolledAt &&
                         incoming().lastAccessedAt == request.time &&
                         (
                           isAdmin() ||
                           (
                             // Strict Student-Only Action: Lesson resume & completion bookmarks ONLY.
                             // Students CANNOT alter passedModuleQuizIds, completedModuleIds, unlockedModuleOrder,
                             // finalAssessmentPassed, bestFinalScorePercent, lastVerified*AttemptId, progressPercent,
                             // completedAt, or transition status to 'completed'.
                             isVerifiedUser() &&
                             isOwner(userId) &&
                             existing().status != 'completed' &&
                             (incoming().status == 'enrolled' || incoming().status == 'in_progress') &&
                             incoming().passedModuleQuizIds == existing().passedModuleQuizIds &&
                             incoming().unlockedModuleOrder == existing().unlockedModuleOrder &&
                             incoming().finalAssessmentPassed == existing().finalAssessmentPassed &&
                             incoming().progressPercent == existing().progressPercent &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'currentModuleId',
                               'currentLessonId',
                               'completedLessonIds',
                               'status',
                               'lastAccessedAt'
                             ])
                           )
                         );

        allow delete: if isAdmin() && isValidId(userId) && isValidId(courseId);
      }

      // Private per-candidate YouTube Video Playback Telemetry (informational playback state only;
      // cannot unlock modules, pass quizzes, or grant certificates).
      match /video_progress/{progressKey} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(progressKey);
        allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAdmin();

        allow create: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(progressKey) &&
                         isValidVideoProgress(incoming(), userId, progressKey) &&
                         incoming().updatedAt == request.time;

        allow update: if isVerifiedUser() &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(progressKey) &&
                         isValidVideoProgress(incoming(), userId, progressKey) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().courseId == existing().courseId &&
                         incoming().lessonId == existing().lessonId &&
                         incoming().videoId == existing().videoId &&
                         incoming().youtubeVideoId == existing().youtubeVideoId &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'durationSeconds',
                           'watchedSeconds',
                           'maxPercentWatched',
                           'lastPositionSeconds',
                           'hasPlayed',
                           'completedViaPlayer',
                           'manualCompleted',
                           'updatedAt'
                         ]);

        allow delete: if isAdmin() && isValidId(userId) && isValidId(progressKey);
      }

      // HARDENED (ZERO STUDENT WRITES): Private per-candidate Quiz & Final Assessment Attempts
      // Students can ONLY read their own attempts. Creating, modifying, or deleting attempts
      // directly from a student client is strictly forbidden — completely blocking fake attempts
      // with arbitrary hex signatures.
      match /assessment_attempts/{attemptId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(attemptId);
        allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAdmin();

        allow create: if isAdmin() &&
                         isValidId(userId) &&
                         isValidId(attemptId) &&
                         isValidAssessmentAttempt(incoming(), userId, attemptId) &&
                         incoming().submittedAt == request.time;

        allow update: if false;
        allow delete: if isAdmin() && isValidId(userId) && isValidId(attemptId);
      }

      // HARDENED (ZERO STUDENT WRITES): Private per-candidate Immutable Course Completion Certificates
      // Students can ONLY read their own certificates. Direct client creation or modification
      // is strictly denied — preventing certificate forgery from browser SDKs.
      match /certificates/{courseId} {
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidId(courseId);
        allow list: if (isOwner(userId) && resource.data.userId == request.auth.uid) || isAdmin();

        allow create: if isAdmin() &&
                         isValidId(userId) &&
                         isValidId(courseId) &&
                         isValidCandidateCertificate(incoming(), userId, courseId) &&
                         incoming().status == 'valid' &&
                         incoming().issuedAt == request.time &&
                         getAfter(/databases/$(database)/documents/public_certificates/$(incoming().certificateId)).data.courseId == courseId &&
                         getAfter(/databases/$(database)/documents/public_certificates/$(incoming().certificateId)).data.status == 'valid';

        allow update: if isAdmin() &&
                         isValidId(userId) &&
                         isValidId(courseId) &&
                         isValidCandidateCertificate(incoming(), userId, courseId) &&
                         incoming().certificateId == existing().certificateId &&
                         incoming().userId == existing().userId &&
                         incoming().courseId == existing().courseId &&
                         incoming().finalAttemptId == existing().finalAttemptId &&
                         incoming().issuedAt == existing().issuedAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status']);

        allow delete: if isAdmin() && isValidId(userId) && isValidId(courseId);
      }
    }

    // =========================================================================
    // PUBLIC CERTIFICATE VERIFICATION REGISTRY (Single-Doc Lookup, Zero Student Writes)
    // =========================================================================

    match /public_certificates/{certificateId} {
      allow get: if isValidCertificateId(certificateId);
      allow list: if isAdmin();

      allow create: if isAdmin() &&
                       isValidCertificateId(certificateId) &&
                       isValidPublicCertificate(incoming(), certificateId) &&
                       incoming().status == 'valid' &&
                       incoming().issuedAt == request.time;

      allow update: if isAdmin() &&
                       isValidCertificateId(certificateId) &&
                       isValidPublicCertificate(incoming(), certificateId) &&
                       incoming().certificateId == existing().certificateId &&
                       incoming().courseId == existing().courseId &&
                       incoming().issuedAt == existing().issuedAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status']);

      allow delete: if isAdmin() && isValidCertificateId(certificateId);
    }

    // =========================================================================
    // ADMIN-MANAGED LEARN WITH ABHI COURSES, MODULES, LESSONS & QUIZ CONFIGS
    // =========================================================================

    match /learning_courses/{courseId} {
      allow get: if isValidId(courseId) && (resource.data.status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isAdmin();

      allow create: if isAdmin() &&
                       isValidId(courseId) &&
                       isValidLearningCourse(incoming(), courseId) &&
                       incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
                       isValidId(courseId) &&
                       isValidLearningCourse(incoming(), courseId) &&
                       incoming().id == existing().id &&
                       incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(courseId);

      // Ordered course modules (Publicly readable curriculum, strictly Admin writable)
      match /modules/{moduleId} {
        allow get: if isValidId(courseId) && isValidId(moduleId);
        allow list: if resource.data.courseId == courseId;

        allow create: if isAdmin() &&
                         isValidId(courseId) &&
                         isValidId(moduleId) &&
                         isValidCourseModule(incoming(), courseId, moduleId) &&
                         incoming().updatedAt == request.time;

        allow update: if isAdmin() &&
                         isValidId(courseId) &&
                         isValidId(moduleId) &&
                         isValidCourseModule(incoming(), courseId, moduleId) &&
                         incoming().id == existing().id &&
                         incoming().courseId == existing().courseId &&
                         incoming().updatedAt == request.time;

        allow delete: if isAdmin() && isValidId(courseId) && isValidId(moduleId);
      }

      // Course lessons & YouTube video metadata (Publicly readable curriculum, strictly Admin writable)
      match /lessons/{lessonId} {
        allow get: if isValidId(courseId) && isValidId(lessonId);
        allow list: if resource.data.courseId == courseId;

        allow create: if isAdmin() &&
                         isValidId(courseId) &&
                         isValidId(lessonId) &&
                         isValidCourseLesson(incoming(), courseId, lessonId) &&
                         incoming().updatedAt == request.time;

        allow update: if isAdmin() &&
                         isValidId(courseId) &&
                         isValidId(lessonId) &&
                         isValidCourseLesson(incoming(), courseId, lessonId) &&
                         incoming().id == existing().id &&
                         incoming().courseId == existing().courseId &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'moduleId',
                           'title',
                           'description',
                           'videoUrl',
                           'videos',
                           'writtenContent',
                           'exerciseTitle',
                           'exerciseInstructions',
                           'exerciseDeliverable',
                           'attachments',
                           'order',
                           'estimatedMinutes',
                           'updatedBy',
                           'updatedAt'
                         ]);

        allow delete: if isAdmin() && isValidId(courseId) && isValidId(lessonId);
      }

      // Admin-Only Quiz & Final Assessment Configurations (Answer keys strictly hidden from students)
      match /quiz_configs/{quizId} {
        allow get: if isAdmin() && isValidId(courseId) && isValidId(quizId);
        allow list: if isAdmin() && resource.data.courseId == courseId;

        allow create: if isAdmin() &&
                         isValidId(courseId) &&
                         isValidId(quizId) &&
                         isValidQuizConfig(incoming(), courseId, quizId) &&
                         incoming().updatedAt == request.time;

        allow update: if isAdmin() &&
                         isValidId(courseId) &&
                         isValidId(quizId) &&
                         isValidQuizConfig(incoming(), courseId, quizId) &&
                         incoming().id == existing().id &&
                         incoming().courseId == existing().courseId &&
                         incoming().updatedAt == request.time;

        allow delete: if isAdmin() && isValidId(courseId) && isValidId(quizId);
      }
    }

    // =========================================================================
    // ADMIN-MANAGED CERTIFICATE TEMPLATES (Publicly readable branding, Admin writable)
    // =========================================================================

    match /certificate_templates/{templateId} {
      allow get: if isValidId(templateId);
      allow list: if true;

      allow create: if isAdmin() &&
                       isValidId(templateId) &&
                       isValidCertificateTemplate(incoming(), templateId) &&
                       incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
                       isValidId(templateId) &&
                       isValidCertificateTemplate(incoming(), templateId) &&
                       incoming().id == existing().id &&
                       incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(templateId);
    }

    // Narrowly-scoped Admin-Only CollectionGroup Audit Rules (strictly for Learn with ABHI course records)
    // Candidate profiles (/users/{userId}) and Career Readiness Assessments (/career_assessments) remain untouched.
    match /{path=**}/course_enrolments/{courseId} {
      allow read: if isAdmin();
    }

    match /{path=**}/video_progress/{progressKey} {
      allow read: if isAdmin();
    }

    match /{path=**}/assessment_attempts/{attemptId} {
      allow read: if isAdmin();
    }

    match /{path=**}/certificates/{courseId} {
      allow read: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
