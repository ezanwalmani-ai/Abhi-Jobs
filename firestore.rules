             data.issueDate is string && data.issueDate.size() > 0 && data.issueDate.size() <= 64 &&
             data.status is string && (data.status == 'valid' || data.status == 'revoked') &&
             (!('issuanceMethod' in data) || (data.issuanceMethod is string && (data.issuanceMethod == 'server_hmac' || data.issuanceMethod == 'admin_approved')));
    }

