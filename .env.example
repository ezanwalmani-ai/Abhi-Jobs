# ==============================================================================
# ABHI JOBS — Environment Variables Template (NAMES ONLY — NEVER COMMIT SECRETS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Public Variables (Safe for browser bundle / Netlify env vars)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
# Preferred modern Supabase publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback alias (only if needed by legacy clients)
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 2. Server-Only & Supabase Edge Function Secrets
#    CRITICAL: NEVER prefix with VITE_, NEVER expose in browser code,
#    NEVER commit values to Git or share in chat.
#    Configure in:
#      - Dev: AI Studio Settings -> Secrets (or local untracked .env)
#      - Supabase Edge Functions: `supabase secrets set KEY=...`
#        (Note: SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY are auto-injected by Supabase)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Preferred modern Supabase Secret Key (sb_secret_...) for project ruagizqernsqypujeutu
SUPABASE_SECRET_KEY=
# Alternative legacy Service Role JWT key (used as fallback if SUPABASE_SECRET_KEY is unset)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# Cryptographic HMAC signing secrets (minimum 32 random chars, shared across Edge Functions)
LEARNING_SIGNING_SECRET=
CERTIFICATE_SIGNING_SECRET=

# Comma-separated browser origins allowed by Edge Function CORS
# Example: https://abhijobs.netlify.app,http://localhost:3000
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 3. Transitional / Legacy Dev Variables (Retained until Phase 5 Cutover)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
ADMIN_ASSESSMENT_PASSCODE=
ADMIN_ASSESSMENT_SESSION_SECRET=
